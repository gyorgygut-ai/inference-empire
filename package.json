{
  "name": "inference-tooling",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/ai",
    "apps/*",
    "packages/worker-router-client",
    "tools/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "deploy": "nx run-many -t deploy",
    "deploy:affected": "nx affected -t deploy --base=origin/main",
    "test-unit": "nx run-many -t test-unit",
    "e2e-sandbox": "nx run-many -t e2e-sandbox",
    "e2e-real": "nx run-many -t e2e-real",
    "lint": "oxlint",
    "generate": "nx run worker-cli-client:generate",
    "py-check": "uv run --locked --group test ruff check . && uv run --locked --group test ty check . && uv run --locked --group test vulture .",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/devkit": "^23.2.1",
    "@nx/eslint": "^23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "^23.2.1",
    "@nx/next": "^23.2.1",
    "@nx/node": "^23.2.1",
    "@nx/plugin": "^23.2.1",
    "@nx/react": "^23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "^23.2.1",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "^23.2.1",
    "oxlint": "^1.87.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0",
    "wrangler": "4.145.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.18",
    "@tanstack/ai": "^0.65.1",
    "@tanstack/ai-client": "^0.18.2",
    "@tanstack/ai-react": "^0.30.0",
    "@tanstack/ai-react-ui": "^0.9.7",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.561.0",
    "next": "~16.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.18",
    "zod": "^4.2.0",
    "@tanstack/ai-openrouter": "0.21.1"
  }
}
