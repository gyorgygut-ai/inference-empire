{
  "name": "inference-tooling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "test-unit": "nx run-many -t test-unit",
    "test-e2e": "nx run-many -t test-e2e",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "verify": "nx run-many -t verify --nxBail --parallel=1",
    "verify:affected": "nx affected -t verify --nxBail --parallel=1 --base=origin/main",
    "py-check": "uv run --locked --group test ruff check . && uv run --locked --group test ty check . && uv run --locked --group test vulture .",
    "lint:fix": "nx run-many -t lint-fix"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^15.5.2",
    "@dotenvx/dotenvx": "^2.38.2",
    "@nx/esbuild": "24.0.1",
    "@nx/jest": "24.0.1",
    "@nx/js": "24.0.1",
    "@nx/next": "24.0.1",
    "@nx/node": "24.0.1",
    "@nx/oxlint": "24.0.1",
    "@nx/plugin": "24.0.1",
    "@nx/react": "24.0.1",
    "@nx/vite": "24.0.1",
    "@nx/vitest": "24.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "esbuild": "^0.27.0",
    "jsdom": "^27.1.0",
    "nx": "24.0.1",
    "oxlint": "^1.87.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vitest": "5.0.5",
    "wrangler": "4.145.0",
    "ws": "^8.18.0",
    "x-to-zod": "^0.10.9"
  },
  "overrides": {
    "nx": {
      "dotenv-expand": "1000.0.0"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.18",
    "@hono/node-server": "^2.1.5",
    "@nx/devkit": "24.0.1",
    "@tanstack/ai": "^0.65.1",
    "@tanstack/ai-client": "^0.18.2",
    "@tanstack/ai-openrouter": "0.21.1",
    "@tanstack/ai-react": "0.30.0",
    "@tanstack/ai-react-ui": "^0.9.7",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "hono": "^4.13.13",
    "itty-router": "^5.0.24",
    "next": "16.2.12",
    "proper-lockfile": "^4.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.18",
    "zod": "^4.2.0"
  }
}
