{
  "name": "inference-tooling",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/gpu-workers/*",
    "packages/contracts",
    "packages/worker-router-client",
    "tools/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "deploy": "nx run-many -t deploy",
    "deploy:affected": "nx affected -t deploy --base=origin/main",
    "test-unit": "nx run-many -t test-unit",
    "test-e2e": "nx run-many -t test-e2e",
    "lint": "nx run-many -t lint",
    "generate": "nx run cli:generate"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
