{
  "name": "inference-tooling",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/gpu-workers/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "deploy": "nx run-many -t deploy",
    "deploy:affected": "nx affected -t deploy --base=origin/main",
    "test-unit": "nx run-many -t test-unit",
    "test-e2e": "nx run-many -t test-e2e",
    "lint": "nx run-many -t lint",
    "generate": "nx run cli:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/devkit": "^23.2.1",
    "@nx/eslint": "^23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "^23.2.1",
    "@nx/next": "^23.2.1",
    "@nx/node": "^23.2.1",
    "@nx/plugin": "^23.2.1",
    "@nx/react": "^23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "^23.2.1",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "^23.2.1",
    "tslib": "^2.3.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {}
}
