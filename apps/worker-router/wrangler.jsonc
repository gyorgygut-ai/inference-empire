{
  "name": "worker-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "CONTRACT": "flux2_klein9b"
  },
  "env": {
    "flux2": {
      "vars": {
        "CONTRACT": "flux2_klein9b"
      }
    },
    "tinysd": {
      "vars": {
        "CONTRACT": "tiny_sd"
      }
    }
  }
}
