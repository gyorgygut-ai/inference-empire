{
  "root": "apps/worker-router",
  "sourceRoot": "apps/worker-router/src",
  "projectType": "application",
  "tags": ["type:app", "scope:router"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "inputs": ["default", "^default"],
      "options": {
        "outputPath": "dist/apps/worker-router",
        "main": "src/index.ts",
        "entryPoints": ["src/index.ts"]
      }
    },
    "dev": {
      "executor": "@nx/vite:dev-server",
      "dependsOn": ["build"],
      "inputs": ["default", "^default"],
      "options": {
        "buildTarget": "worker-router:build"
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "inputs": ["default"],
      "options": {}
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "inputs": ["default", "{workspaceRoot}/eslint.config.mjs"],
      "options": {}
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wrangler deploy --env production",
        "cwd": "apps/worker-router"
      },
      "dependsOn": ["build"]
    },
    "deploy-staging": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wrangler deploy --env staging",
        "cwd": "apps/worker-router"
      },
      "dependsOn": ["build"]
    }
  }
}