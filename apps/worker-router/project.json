{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "worker-router",
  "root": "apps/worker-router",
  "sourceRoot": "apps/worker-router/src",
  "projectType": "application",
  "tags": ["type:app", "scope:router"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "inputs": ["default", "^default"],
      "options": {
        "outputPath": "dist/apps/worker-router",
        "main": "src/index.ts",
        "entryPoints": ["src/index.ts"]
      }
    },
    "dev": {
      "executor": "@nx/vite:dev-server",
      "dependsOn": ["build"],
      "inputs": ["default", "^default"],
      "options": {
        "buildTarget": "worker-router:build"
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "inputs": ["default"],
      "options": {}
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "inputs": ["default", "{workspaceRoot}/eslint.config.mjs"],
      "options": {}
    },
    "build-manifest": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'worker-router manifest is generated per-deployment by deploy-worker scripts'",
        "cwd": "apps/worker-router"
      },
      "cache": true
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wrangler deploy --env production",
        "cwd": "apps/worker-router"
      },
      "dependsOn": ["build"]
    },
    "deploy-worker": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/deploy-worker.mjs --contract-path {contractPath} --worker-name {workerName} --provider-type {providerType} --provider-token {providerToken} --provider-api-url {providerApiUrl} --provider-app-name {providerAppName}",
        "cwd": "apps/worker-router"
      },
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
