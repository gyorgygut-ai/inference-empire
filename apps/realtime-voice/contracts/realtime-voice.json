{
  "input": {
    "title": "RealtimeVoiceInput",
    "required": ["audio", "voice"],
    "properties": {
      "audio": { "type": "string", "description": "Base64 pcm16 mono audio input" },
      "sample_rate": { "type": "integer", "default": 24000 },
      "voice": { "type": "string" },
      "language": { "type": "string", "default": "en" }
    }
  },
  "output": {
    "title": "RealtimeVoiceOutput",
    "required": ["audio", "transcript"],
    "properties": {
      "audio": { "type": "string", "description": "Base64 pcm16 mono reply audio" },
      "transcript": { "type": "string" },
      "sample_rate": { "type": "integer", "default": 24000 }
    }
  }
}
