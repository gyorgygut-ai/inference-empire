{
  "name": "voice-chat",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/voice-chat",
  "targets": {
    "predev": {
      "executor": "nx:noop",
      "dependsOn": ["prebuild"]
    },
    "prebuild": {
      "executor": "nx:noop",
      "dependsOn": [
        "^prebuild",
        {
          "projects": ["schemas"],
          "target": "build-ts",
          "options": "forward"
        }
      ],
      "options": {
        "source": "packages/schemas/workers/voice.schema.json",
        "out": "apps/voice-chat/dist/voice.schema.ts"
      }
    },
    "build": {
      "dependsOn": [
        "prebuild",
        "build:manifest",
        "^build"
      ],
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ]
    },
    "test-unit": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "options": {
        "command": "npx vitest run",
        "args": "--config apps/voice-chat/vitest.config.mts"
      }
    },
    "dev": {
      "executor": "dotenvx:run-commands",
      "continuous": true,
      "cache": false,
      "readyWhen": {
        "url": "http://localhost:{env.DEV_VOICE_CHAT_PORT}"
      },
      "dependsOn": [
        "predev",
        { "projects": ["workers-voice"], "target": "deploy-realtime-session-beam" }
      ],
      "options": {
        "cwd": "apps/voice-chat",
        "env": {
          "SECRET_WORKER_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts workers-voice-realtime-session)",
          "SECRET_BEAM_TOKEN": "${SECRET_BEAM_TOKEN}",
          "GENERATED_VOICE_WORKER_AUTH_TOKEN": "${GENERATED_VOICE_WORKER_AUTH_TOKEN}",
          "OPENAI_API_KEY": "${SECRET_OPENAI_API_KEY}"
        },
        "command": "npx next dev",
        "args": "--port=\"$DEV_VOICE_CHAT_PORT\""
      }
    },
    "deploy": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": [
        "build",
        { "projects": ["workers-voice"], "target": "deploy-realtime-session-beam" }
      ],
      "options": {
        "cwd": ".",
        "env": {
          "SECRET_WORKER_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts workers-voice-realtime-session)",
          "SECRET_BEAM_TOKEN": "${SECRET_BEAM_TOKEN}",
          "GENERATED_VOICE_WORKER_AUTH_TOKEN": "${GENERATED_VOICE_WORKER_AUTH_TOKEN}",
          "OPENAI_API_KEY": "${SECRET_OPENAI_API_KEY}",
          "VERCEL_TOKEN": "${SECRET_VOICE_CHAT_VERCEL_TOKEN}",
          "VERCEL_ORG_ID": "${SECRET_VOICE_CHAT_VERCEL_ORG_ID}",
          "VERCEL_PROJECT_ID": "${SECRET_VOICE_CHAT_VERCEL_PROJECT_ID}"
        },
        "command": "npx vercel build --project \"$VERCEL_PROJECT_ID\" --prod --yes && npx vercel deploy --project \"$VERCEL_PROJECT_ID\" --prebuilt --prod",
        "args": "--yes -e SECRET_WORKER_URL=\"$SECRET_WORKER_URL\" -e GENERATED_VOICE_WORKER_AUTH_TOKEN=\"$GENERATED_VOICE_WORKER_AUTH_TOKEN\" -e OPENAI_API_KEY=\"$OPENAI_API_KEY\""
      }
    }
  }
}
