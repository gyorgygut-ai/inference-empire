{
  "name": "voice-chat",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/voice-chat",
  "targets": {
    "predev": {
      "executor": "nx:noop",
      "dependsOn": ["prebuild"]
    },
    "prebuild": {
      "executor": "nx:noop",
      "dependsOn": ["^prebuild"]
    },
    "build": {
      "executor": "dotenvx:run-commands",
      "dependsOn": [
        "prebuild"
      ],
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "options": {
        "command": "npm run",
        "args": "build",
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "executor": "dotenvx:run-commands",
      "continuous": true,
      "cache": false,
      "readyWhen": {
        "url": "http://localhost:{env.VOICE_CHAT_PORT}"
      },
      "dependsOn": ["predev"],
      "options": {
        "cwd": "apps/voice-chat",
        "env": {
          "WORKER_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts workers-voice)",
          "BEAM_TOKEN": "${BEAM_TOKEN}",
          "OPENAI_API_KEY": "${SECRET_OPENAI_API_KEY}"
        },
        "command": "npx next dev",
        "args": "--port=\"$VOICE_CHAT_PORT\""
      }
    },
    "deploy": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": ["build", "workers-voice:deploy-beam"],
      "options": {
        "cwd": "apps/voice-chat",
        "env": {
          "WORKER_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts workers-voice)",
          "BEAM_TOKEN": "${BEAM_TOKEN}",
          "OPENAI_API_KEY": "${SECRET_OPENAI_API_KEY}",
          "VERCEL_TOKEN": "${VOICE_CHAT_VERCEL_TOKEN}",
          "VERCEL_ORG_ID": "${VOICE_CHAT_VERCEL_ORG_ID}",
          "VERCEL_PROJECT_ID": "${VOICE_CHAT_VERCEL_PROJECT_ID}"
        },
        "command": "npx vercel deploy",
        "args": "--yes -e WORKER_URL=\"$WORKER_URL\" -b WORKER_URL=\"$WORKER_URL\" -e BEAM_TOKEN=\"$BEAM_TOKEN\" -e OPENAI_API_KEY=\"$OPENAI_API_KEY\""
      }
    }
  }
}
