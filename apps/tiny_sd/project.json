{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "worker-tiny_sd",
  "projectType": "application",
  "sourceRoot": "apps/tiny_sd",
  "tags": ["type:app", "scope:gpu-worker", "model:tiny-sd"],
  "targets": {
    "dev-modal": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "continuous": true,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/tiny_sd/dev.env"],
      "options": {
        "command": "uv run --locked python tools/serve-modal.py",
        "args": "apps/tiny_sd/worker_modal_cls_tiny_sd.py",
        "envFile": "dist/tiny_sd/dev.env",
        "envKey": "MODAL_WORKER_URL"
      }
    },
    "dev-beam": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "continuous": true,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/tiny_sd/dev.env"],
      "options": {
        "command": "uv run --locked python tools/serve-beam.py",
        "args": "apps/tiny_sd/worker_beam_tq_tiny_sd.py",
        "envFile": "dist/tiny_sd/dev.env",
        "envKey": "BEAM_WORKER_URL"
      }
    },
    "dev-flash": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "continuous": true,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/tiny_sd/dev.env"],
      "options": {
        "command": "uv run --locked python tools/serve-flash.py",
        "args": "apps/tiny_sd/worker_flash_cls_tiny_sd.py",
        "envFile": "dist/tiny_sd/dev.env",
        "envKey": "FLASH_WORKER_URL"
      }
    },
    "deploy-modal": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/tiny_sd/deploy.env"],
      "options": {
        "command": "npx tsx tools/deploy-modal.ts",
        "args": "apps/tiny_sd/worker_modal_cls_tiny_sd.py",
        "envFile": "dist/tiny_sd/deploy.env",
        "envKey": "MODAL_WORKER_URL"
      }
    },
    "deploy-beam": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/tiny_sd/deploy.env"],
      "options": {
        "command": "npx tsx tools/deploy-beam.ts",
        "args": "apps/tiny_sd/worker_beam_tq_tiny_sd.py",
        "envFile": "dist/tiny_sd/deploy.env",
        "envKey": "BEAM_WORKER_URL"
      }
    },
    "deploy-flash": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/tiny_sd/deploy.env"],
      "options": {
        "command": "npx tsx tools/deploy-flash.ts",
        "args": "apps/tiny_sd/worker_flash_cls_tiny_sd.py",
        "envFile": "dist/tiny_sd/deploy.env",
        "envKey": "FLASH_WORKER_URL"
      }
    }
  }
}
