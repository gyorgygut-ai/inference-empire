{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "tiny_sd",
  "projectType": "application",
  "sourceRoot": "apps/tiny_sd",
  "tags": [
    "type:app",
    "scope:worker",
    "model:tiny-sd"
  ],
  "targets": {
    "test-unit": {
      "executor": "@inference/workspace-plugin:pytest",
      "options": {
        "family": "tiny_sd",
        "mode": "unit"
      },
      "inputs": [
        "default"
      ],
      "cache": true
    },
    "test-e2e": {
      "executor": "@inference/workspace-plugin:pytest",
      "options": {
        "family": "tiny_sd",
        "mode": "e2e"
      },
      "cache": false
    },
    "lint": {
      "executor": "@inference/workspace-plugin:ruff",
      "options": {
        "family": "tiny_sd"
      },
      "cache": true
    },
    "typecheck": {
      "executor": "@inference/workspace-plugin:ty",
      "options": {
        "family": "tiny_sd"
      },
      "cache": true
    },
    "verify-deploy-gate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run python -c \"from apps.tiny_sd._shared_tiny_sd import IMAGE_PIP_DEPS; print('\\n'.join(IMAGE_PIP_DEPS))\" | uv pip compile --python-version 3.11 -",
        "cwd": "."
      },
      "cache": true
    },
    "deploy-modal": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked modal deploy apps/tiny_sd/worker_modal_cls_tiny_sd.py && node apps/tiny_sd/scripts/modal-output.mjs",
        "cwd": "."
      },
      "dependsOn": [
        "verify-deploy-gate"
      ],
      "cache": false,
      "outputs": [
        "{workspaceRoot}/dist/apps/tiny_sd"
      ]
    },
    "deploy-beam": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/tiny_sd/scripts/deploy-beam.mjs",
        "cwd": "."
      },
      "dependsOn": [
        "verify-deploy-gate"
      ],
      "cache": false,
      "outputs": [
        "{workspaceRoot}/dist/apps/tiny_sd"
      ]
    },
    "deploy-flash": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'flash deploy disabled'",
        "cwd": "."
      },
      "dependsOn": [
        "verify-deploy-gate"
      ],
      "cache": false,
      "outputs": [
        "{workspaceRoot}/dist/apps/tiny_sd"
      ]
    },
    "deploy-worker": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node deploy-worker.mjs",
        "cwd": "apps/tiny_sd"
      },
      "dependsOn": [
        "deploy-modal",
        "deploy-beam",
        "deploy-flash",
        "worker-router:build"
      ],
      "cache": false
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'tiny_sd deploy complete (router + providers)'",
        "cwd": "."
      },
      "dependsOn": [
        "deploy-worker"
      ],
      "cache": false
    }
  }
}
