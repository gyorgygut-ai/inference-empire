{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "worker-h3_ref2va",
  "projectType": "application",
  "sourceRoot": "apps/h3_ref2va",
  "tags": ["type:app", "scope:gpu-worker", "model:h3-ref2va"],
  "targets": {
    "dev-modal": {
      "executor": "orchestrator:run-command-with-artifact",
      "options": {
        "command": "uv run --locked python tools/serve-modal.py",
        "args": ["worker-h3_ref2va", "dev"],
        "artifact": "{workspaceRoot}/dist/worker-h3_ref2va/dev/MODAL_WORKER_URL"
      }
    },
    "dev-beam": {
      "executor": "orchestrator:run-command-with-artifact",
      "options": {
        "command": "uv run --locked python tools/serve-beam.py",
        "args": ["worker-h3_ref2va", "dev"],
        "artifact": "{workspaceRoot}/dist/worker-h3_ref2va/dev/BEAM_WORKER_URL"
      }
    },
    "dev-flash": {
      "executor": "orchestrator:run-command-with-artifact",
      "options": {
        "command": "uv run --locked python tools/serve-flash.py",
        "args": ["worker-h3_ref2va", "dev"],
        "artifact": "{workspaceRoot}/dist/worker-h3_ref2va/dev/FLASH_WORKER_URL"
      }
    },
    "deploy-modal": {
      "executor": "orchestrator:run-command-with-artifact",
      "options": {
        "command": "npx tsx tools/deploy-modal.ts",
        "args": ["worker-h3_ref2va", "deploy"],
        "artifact": "{workspaceRoot}/dist/worker-h3_ref2va/deploy/MODAL_WORKER_URL"
      }
    },
    "deploy-beam": {
      "executor": "orchestrator:run-command-with-artifact",
      "options": {
        "command": "npx tsx tools/deploy-beam.ts",
        "args": ["worker-h3_ref2va", "deploy"],
        "artifact": "{workspaceRoot}/dist/worker-h3_ref2va/deploy/BEAM_WORKER_URL"
      }
    },
    "deploy-flash": {
      "executor": "orchestrator:run-command-with-artifact",
      "options": {
        "command": "npx tsx tools/deploy-flash.ts",
        "args": ["worker-h3_ref2va", "deploy"],
        "artifact": "{workspaceRoot}/dist/worker-h3_ref2va/deploy/FLASH_WORKER_URL"
      }
    }
  }
}
