{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "h3_comfy",
  "projectType": "application",
  "sourceRoot": "apps/h3_comfy",
  "tags": [
    "type:app",
    "scope:worker",
    "model:h3-comfy"
  ],
  "targets": {
    "test-unit": {
      "executor": "@inference/workspace-plugin:pytest",
      "options": {
        "family": "h3_comfy",
        "mode": "unit"
      },
      "inputs": [
        "default"
      ],
      "cache": true
    },
    "test-e2e": {
      "executor": "@inference/workspace-plugin:pytest",
      "options": {
        "family": "h3_comfy",
        "mode": "e2e"
      },
      "cache": false
    },
    "lint": {
      "executor": "@inference/workspace-plugin:ruff",
      "options": {
        "family": "h3_comfy"
      },
      "cache": true
    },
    "typecheck": {
      "executor": "@inference/workspace-plugin:ty",
      "options": {
        "family": "h3_comfy"
      },
      "cache": true
    },
    "verify-deploy-gate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run python -c \"from apps.h3_comfy._shared_minimax_h3_comfy import IMAGE_PIP_DEPS; print('\\n'.join(IMAGE_PIP_DEPS))\" | uv pip compile --python-version 3.11 -",
        "cwd": "."
      },
      "cache": true
    },
    "deploy-modal": {
      "executor": "nx:run-commands",
      "options": {
        "command": "PYTHONPATH=\"$PWD\" uv run --locked modal deploy apps/h3_comfy/worker_modal_cls_minimax_h3_comfy.py && node apps/h3_comfy/scripts/modal-output.mjs",
        "cwd": "."
      },
      "dependsOn": [
        "verify-deploy-gate"
      ],
      "cache": false,
      "outputs": [
        "{workspaceRoot}/dist/apps/h3_comfy"
      ]
    },
    "deploy-beam": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/h3_comfy/scripts/deploy-beam.mjs",
        "cwd": "."
      },
      "dependsOn": [
        "verify-deploy-gate"
      ],
      "cache": false,
      "outputs": [
        "{workspaceRoot}/dist/apps/h3_comfy"
      ]
    },
    "deploy-worker": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node deploy-worker.mjs",
        "cwd": "apps/h3_comfy"
      },
      "dependsOn": [
        "deploy-modal",
        // "deploy-beam",
        "worker-router:build"
      ],
      "cache": false
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'h3_comfy deploy complete (router + providers)'",
        "cwd": "."
      },
      "dependsOn": [
        "deploy-worker"
      ],
      "cache": false
    }
  }
}