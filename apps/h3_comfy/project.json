{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "worker-h3_comfy",
  "projectType": "application",
  "sourceRoot": "apps/h3_comfy",
  "tags": ["type:app", "scope:gpu-worker", "model:h3-comfy"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "modal serve worker_modal_cls_minimax_h3_comfy.py",
        "cwd": "apps/h3_comfy"
      },
      "outputs": ["{projectRoot}/dist/dev-endpoint.json"],
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["deploy-modal", "deploy-beam"],
      "outputs": ["{projectRoot}/dist/deploy-endpoints.json"],
      "cache": false
    },
    "deploy-modal": {
      "executor": "@inference/deploy-worker:deploy-modal",
      "cache": false,
      "options": { "worker": "worker_modal_cls_minimax_h3_comfy.py" }
    },
    "deploy-beam": {
      "executor": "@inference/deploy-worker:deploy-beam",
      "cache": false,
      "options": { "worker": "worker_beam_tq_minimax_h3_comfy.py", "name": "minimax-h3-comfy", "entrypoint": "dispatch" }
    }
  }
}
