{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "assistant-ui-media",
  "projectType": "application",
  "sourceRoot": "apps/assistant-ui-media",
  "tags": ["type:app", "scope:client"],
  "implicitDependencies": ["flux2", "krea2", "worker-router"],
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "options": {
        "script": "build"
      },
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/.next"],
      "cache": true
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/serve.mjs",
        "cwd": "apps/assistant-ui-media",
        "env": {
          "FLUX2_ROUTER_URL": "http://127.0.0.1:8787",
          "FLUX2_ROUTER_TOKEN": "dev-local-router-token",
          "KREA2_ROUTER_URL": "http://127.0.0.1:8788",
          "KREA2_ROUTER_TOKEN": "dev-local-router-token"
        }
      },
      "dependsOn": ["worker-router:flux2", "worker-router:krea2"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "executor": "nx:run-script",
      "options": { "script": "start" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit -p tsconfig.json",
        "cwd": "apps/assistant-ui-media"
      },
      "cache": true
    },
    "test-unit": {
      "executor": "nx:run-script",
      "options": {
        "script": "test:run"
      },
      "cache": true
    }
  }
}
