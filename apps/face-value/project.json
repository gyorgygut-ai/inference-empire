{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "face-value",
  "projectType": "application",
  "sourceRoot": "apps/face-value",
  "tags": ["type:app", "scope:face-value"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "dependsOn": [
        "router:dev-flux2",
        "router:dev-flux2-generate-router-url",
        "schemas:generate-flux2-*"
      ],
      "options": {
        "command": "npm run dev",
        "cwd": "apps/face-value",
        "envFile": "dist/flux2/dev.env"
      }
    },
    "deploy": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "dependsOn": [
        { "projects": ["router"], "target": "deploy-flux2", "options": "forward" },
        "schemas:generate-flux2-*"
      ],
      "options": {
        "command": "tools/deploy-vercel.ts face-value from-root --token $FACE_VALUE_VERCEL_TOKEN --org $FACE_VALUE_VERCEL_ORG_ID --project-id $FACE_VALUE_VERCEL_PROJECT_ID",
        "envKey": "FACE_VALUE_URL",
        "envFile": "dist/flux2/deploy.env"
      }
    }
  }
}
