{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "face-value",
  "projectType": "application",
  "sourceRoot": "apps/face-value",
  "tags": ["type:app", "scope:client"],
  "implicitDependencies": [],
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "options": {
        "script": "build"
      },
      "dependsOn": ["flux2:deploy-worker"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/.next"],
      "cache": true
    },
    "dev": {
      "executor": "nx:run-script",
      "options": { "script": "dev" },
      "cache": false,
      "persistent": true
    },
    "start": {
      "executor": "nx:run-script",
      "options": { "script": "start" }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "exclude": ["{projectRoot}/.next/**"]
      },
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit -p tsconfig.json",
        "cwd": "apps/face-value"
      },
      "cache": true
    },
    "test-unit": {
      "executor": "nx:run-script",
      "options": {
        "script": "test:run"
      },
      "cache": true
    },
    "deploy-env": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/push-router-env.mjs"
      },
      "dependsOn": ["flux2:deploy-worker"],
      "cache": false
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vercel deploy --prod --yes --token=$VERCEL_TOKEN"
      },
      "dependsOn": ["deploy-env"],
      "cache": false
    }
  }
}
