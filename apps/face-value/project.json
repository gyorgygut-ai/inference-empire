{
  "name": "face-value",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/face-value/src",
  "targets": {
    "predev": {
      "executor": "nx:noop",
      "dependsOn": ["prebuild"]
    },
    "prebuild": {
      "executor": "nx:noop",
      "dependsOn": [
        "^prebuild",
        {
          "projects": ["schemas"],
          "target": "build-ts",
          "options": "forward"
        }
      ],
      "options": {
        "source": "packages/schemas/workers/flux2.schema.json",
        "out": "apps/face-value/dist/flux2.schema.ts"
      }
    },
    "build": {
      "dependsOn": [
        "prebuild",
        "build:manifest",
        "^build"
      ],
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ]
    },
    "dev": {
      "executor": "dotenvx:run-commands",
      "continuous": true,
      "cache": false,
      "readyWhen": {
        "url": "http://localhost:{env.DEV_FACE_VALUE_PORT}"
      },
      "dependsOn": [
        "predev",
        {
          "projects": [
            "router"
          ],
          "target": "dev-flux2",
          "waitFor": "ready"
        }
      ],
      "options": {
        "cwd": "apps/face-value",
        "env": {
          "ROUTER_URL": "http://localhost:${DEV_ROUTER_FLUX2_PORT}",
          "ROUTER_AUTH_TOKEN": "${GENERATED_ROUTER_FLUX2_AUTH_TOKEN}"
        },
        "command": "npx next dev",
        "args": "--port=\"$DEV_FACE_VALUE_PORT\""
      }
    },
    "deploy": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": [
        "build",
        "router:deploy-flux2"
      ],
      "options": {
        "cwd": ".",
        "env": {
          "ROUTER_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-cf-worker-url.ts router_flux2)",
          "ROUTER_AUTH_TOKEN": "${GENERATED_ROUTER_FLUX2_AUTH_TOKEN}",
          "VERCEL_TOKEN": "${SECRET_FACE_VALUE_VERCEL_TOKEN}",
          "VERCEL_ORG_ID": "${SECRET_FACE_VALUE_VERCEL_ORG_ID}",
          "VERCEL_PROJECT_ID": "${SECRET_FACE_VALUE_VERCEL_PROJECT_ID}"
        },
        "command": "npx vercel deploy --project \"$VERCEL_PROJECT_ID\" --prod",
        "args": "--yes -b ROUTER_URL=\"$ROUTER_URL\" -b ROUTER_AUTH_TOKEN=\"$ROUTER_AUTH_TOKEN\" -e ROUTER_URL=\"$ROUTER_URL\" -e ROUTER_AUTH_TOKEN=\"$ROUTER_AUTH_TOKEN\""
      }
    }
  }
}
