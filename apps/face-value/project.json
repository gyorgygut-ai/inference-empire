{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "face-value",
  "projectType": "application",
  "sourceRoot": "apps/face-value",
  "tags": ["type:app", "scope:client"],
  "implicitDependencies": ["flux2", "worker-router"],
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "options": {
        "script": "build"
      },
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/.next"],
      "cache": true
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/serve.mjs",
        "cwd": "apps/face-value",
        "env": {
          "FLUX2_ROUTER_URL": "http://127.0.0.1:8787"
        }
      },
      "dependsOn": ["worker-router:flux2"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "executor": "nx:run-script",
      "options": { "script": "start" }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "exclude": ["{projectRoot}/.next/**", "{projectRoot}/.vercel/**"]
      },
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit -p tsconfig.json",
        "cwd": "apps/face-value"
      },
      "cache": true
    },
    "test-unit": {
      "executor": "nx:run-script",
      "options": {
        "script": "test:run"
      },
      "cache": true
    },
    "deploy-env": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/face-value/scripts/push-router-env.mjs",
        "cwd": "."
      },
      "dependsOn": ["worker-router:deploy"],
      "inputs": [
        {
          "dependentTasksOutputFiles": "{workspaceRoot}/dist/apps/flux2/**"
        }
      ],
      "cache": false
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/face-value/scripts/deploy.mjs",
        "cwd": "."
      },
      "dependsOn": ["deploy-env"],
      "cache": false
    }
  }
}
