{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "face-value",
  "projectType": "application",
  "sourceRoot": "apps/face-value",
  "tags": [
    "type:app",
    "scope:frontend"
  ],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "dependsOn": [
        {
          "projects": [
            "router"
          ],
          "target": "dev-flux2",
          "params": "forward"
        },
        "generate-ts"
      ],
      "options": {
        "command": "npx tsx tools/export-artifacts.ts --exclude PORT dist/router-flux2/dev -- npm --prefix apps/face-value run dev"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": [
            "router"
          ],
          "target": "deploy-flux2",
          "params": "forward"
        },
        "generate-ts"
      ],
      "options": {
        "command": "npx tsx tools/export-artifacts.ts dist/router-flux2/deploy -- npx tsx tools/deploy-vercel.ts face-value from-root --token $FACE_VALUE_VERCEL_TOKEN --org $FACE_VALUE_VERCEL_ORG_ID --project-id $FACE_VALUE_VERCEL_PROJECT_ID"
      }
    },
    "generate-ts": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        {
          "projects": [
            "router"
          ],
          "target": "generate-api-flux2"
        }
      ],
      "inputs": [
        "{workspaceRoot}/dist/router-flux2/api.json"
      ],
      "outputs": [
        "{projectRoot}/generated/router_api.ts"
      ],
      "options": {
        "command": "tsx apps/router/scripts/generate-ts.ts dist/router-flux2/api.json apps/face-value/generated/router_api.ts"
      }
    }
  }
}
