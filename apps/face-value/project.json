{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "face-value",
  "projectType": "application",
  "sourceRoot": "apps/face-value",
  "tags": ["type:app", "scope:face-value"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "dependsOn": [
        { "target": "router:dev-flux2", "options": "forward" },
        "router:dev-flux2-generate-router-url",
        "schemas:generate-flux2-*"
      ],
      "options": {
        "command": "ROUTER_URL=$FLUX2_ROUTER_URL npm run dev",
        "cwd": "apps/face-value",
        "envFile": "dist/flux2/dev.env"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        { "target": "router:deploy-flux2", "options": "forward" },
        "schemas:generate-flux2-*"
      ],
      "options": {
        "command": "tools/deploy-vercel.ts --token $FACE_VALUE_VERCEL_TOKEN --org $FACE_VALUE_VERCEL_ORG_ID --project-id $FACE_VALUE_VERCEL_PROJECT_ID",
        "envKey": "FACE_VALUE_URL",
        "envFile": "dist/flux2/deploy.env"
      }
    }
  }
}
