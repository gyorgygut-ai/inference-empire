{
  "name": "face-value",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/face-value/src",
  "targets": {
    "predev": {
      "executor": "nx:noop",
      "dependsOn": [
        "^prebuild",
        { "projects": ["schemas"], "target": "build" }
      ]
    },
    "prebuild": {
      "executor": "nx:noop",
      "dependsOn": [
        "^prebuild",
        { "projects": ["schemas"], "target": "build" }
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "prebuild"
      ],
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "options": {
        "command": "npm run build",
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "executor": "orchestrator:run-command",
      "continuous": true,
      "cache": false,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": [
        "predev",
        {
          "projects": [
            "functions"
          ],
          "target": "dev-flux2",
          "waitFor": "ready"
        }
      ],
      "inputs": [
        "{workspaceRoot}/packages/contracts/task-queue-service/flux2-dev.contract.ts"
      ],
      "options": {
        "command": "ROUTER_URL=$NX_READY_URL ROUTER_AUTH_TOKEN=$ROUTER_GENERATED_AUTH_TOKEN npx tsx tools/serve-next.ts",
        "args": "--port 3000"
      }
    },
    "deploy": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "dependsOn": [
        "build",
        "functions:deploy-flux2"
      ],
      "inputs": [
        "{workspaceRoot}/packages/contracts/task-queue-service/flux2-deploy.contract.ts"
      ],
      "options": {
        "command": "ROUTER_URL=$ROUTER_RESOLVED_URL ROUTER_AUTH_TOKEN=$ROUTER_GENERATED_AUTH_TOKEN npx vercel deploy",
        "args": "--token={options.token} --orgId={options.orgId} --projectId={options.projectId}",
        "token": "env.FACE_VALUE_VERCEL_TOKEN",
        "orgId": "...",
        "projectId": "...",
        "siteId": "cd41f060-bbdf-49fa-82a6-20d7ba136853"
      }
    }
  }
}
