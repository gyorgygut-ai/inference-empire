{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "face-value",
  "projectType": "application",
  "sourceRoot": "apps/face-value",
  "tags": [
    "type:app",
    "scope:frontend"
  ],
  "targets": {
    "dev": {
      "executor": "orchestrator:run-injected-command",
      "cache": false,
      "dependsOn": [
        {
          "projects": [
            "router"
          ],
          "target": "router-flux2",
          "params": "forward"
        },
        "generate-ts"
      ],
      "inputs": [
        "{projectRoot}/env.schema.ts",
        "{workspaceRoot}/dist/router-flux2/dev/PORT",
        "{workspaceRoot}/dist/router-flux2/dev/SECRET_AUTH_TOKEN"
      ],
      "options": {
        "command": "npm run dev",
        "cwd": "apps/face-value",
        "inject": [
          {
            "env": "ROUTER_URL",
            "command": "../../tools/resolve-local-url.ts",
            "args": [
              "4201"
            ]
          },
          {
            "env": "ROUTER_SECRET_AUTH_TOKEN",
            "command": "../../tools/wait-for-artifact.ts",
            "args": [
              "input",
              "../../dist/router-flux2/dev/SECRET_AUTH_TOKEN"
            ]
          }
        ]
      }
    },
    "deploy": {
      "executor": "orchestrator:run-injected-command",
      "cache": false,
      "dependsOn": [
        {
          "projects": [
            "router"
          ],
          "target": "router-flux2-deploy",
          "params": "forward"
        },
        "generate-ts"
      ],
      "inputs": [
        "{projectRoot}/env.schema.ts",
        "{workspaceRoot}/dist/router-flux2/deploy/ROUTER_URL",
        "{workspaceRoot}/dist/router-flux2/deploy/SECRET_AUTH_TOKEN"
      ],
      "options": {
        "command": "tsx tools/deploy-vercel.ts face-value face-value face-value deploy APP_URL --token $FACE_VALUE_VERCEL_TOKEN --org $FACE_VALUE_VERCEL_ORG_ID --project-id $FACE_VALUE_VERCEL_PROJECT_ID",
        "cwd": ".",
        "inject": [
          {
            "env": "ROUTER_URL",
            "command": "tools/wait-for-artifact.ts",
            "args": [
              "input",
              "dist/router-flux2/deploy/ROUTER_URL"
            ]
          },
          {
            "env": "ROUTER_SECRET_AUTH_TOKEN",
            "command": "tools/wait-for-artifact.ts",
            "args": [
              "input",
              "dist/router-flux2/deploy/SECRET_AUTH_TOKEN"
            ]
          }
        ]
      }
    },
    "generate-ts": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        {
          "projects": [
            "router"
          ],
          "target": "router-flux2-generate-api"
        }
      ],
      "inputs": [
        "{workspaceRoot}/dist/router-flux2/dev/api.json"
      ],
      "outputs": [
        "{projectRoot}/generated/router_api.ts"
      ],
      "options": {
        "command": "tsx apps/router/scripts/generate-ts.ts dist/router-flux2/dev/api.json apps/face-value/generated/router_api.ts"
      }
    }
  }
}
