{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "face-value",
  "projectType": "application",
  "sourceRoot": "apps/face-value",
  "tags": ["type:app", "scope:face-value"],
  "targets": {
    "predev": {
      "executor": "nx:noop",
      "dependsOn": ["^prebuild"]
    },
    "prebuild": {
      "executor": "nx:noop",
      "dependsOn": ["^prebuild"]
    },
    "build": {
      "dependsOn": ["prebuild"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "readyWhen": { "port": 3000 },
      "dependsOn": [
        "predev",
        {
          "projects": ["functions"],
          "target": "dev-flux2",
          "waitFor": "ready"
        }
      ],
      "options": {
        "command": "npm run build:manifest && ROUTER_RESOLVED_URL=\"${NX_READY_URL:?router did not signal}\" next dev -p 3000",
        "cwd": "apps/face-value",
        "envFile": "dist/functions/flux2-dev.env"
      }
    },
    "deploy": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "dependsOn": ["build", "functions:deploy-flux2"],
      "options": {
        "command": "tools/deploy-vercel.ts face-value from-root --token $FACE_VALUE_VERCEL_TOKEN --org $FACE_VALUE_VERCEL_ORG_ID --project-id $FACE_VALUE_VERCEL_PROJECT_ID && VERCEL_TOKEN=$FACE_VALUE_VERCEL_TOKEN tools/orchestrator/src/get-vercel-url.ts $FACE_VALUE_VERCEL_PROJECT_ID --org $FACE_VALUE_VERCEL_ORG_ID",
        "needs": [{ "contract": "task-queue-service/flux2-deploy" }],
        "envKey": "FACE_VALUE_URL",
        "envFile": "dist/functions/flux2-deploy.env"
      }
    }
  }
}
