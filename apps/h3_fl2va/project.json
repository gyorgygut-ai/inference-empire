{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "worker-h3_fl2va",
  "projectType": "application",
  "sourceRoot": "apps/h3_fl2va",
  "tags": ["type:app", "scope:gpu-worker", "model:h3-fl2va"],
  "targets": {
    "dev-modal": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "continuous": true,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/h3_fl2va/dev.env"],
      "options": {
        "command": "uv run --locked python tools/serve-modal.py",
        "args": "apps/h3_fl2va/worker_modal_cls_minimax_h3_fl2va.py",
        "envFile": "dist/h3_fl2va/dev.env",
        "envKey": "MODAL_WORKER_URL"
      }
    },
    "dev-beam": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "continuous": true,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/h3_fl2va/dev.env"],
      "options": {
        "command": "uv run --locked python tools/serve-beam.py",
        "args": "apps/h3_fl2va/worker_beam_tq_minimax_h3_fl2va.py",
        "envFile": "dist/h3_fl2va/dev.env",
        "envKey": "BEAM_WORKER_URL"
      }
    },
    "deploy-modal": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/h3_fl2va/deploy.env"],
      "options": {
        "command": "npx tsx tools/deploy-modal.ts",
        "args": "apps/h3_fl2va/worker_modal_cls_minimax_h3_fl2va.py",
        "envFile": "dist/h3_fl2va/deploy.env",
        "envKey": "MODAL_WORKER_URL"
      }
    },
    "deploy-beam": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/h3_fl2va/deploy.env"],
      "options": {
        "command": "npx tsx tools/deploy-beam.ts",
        "args": "apps/h3_fl2va/worker_beam_tq_minimax_h3_fl2va.py",
        "envFile": "dist/h3_fl2va/deploy.env",
        "envKey": "BEAM_WORKER_URL"
      }
    }
  }
}
