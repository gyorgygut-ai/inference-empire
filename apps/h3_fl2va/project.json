{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "h3_fl2va",
  "projectType": "application",
  "sourceRoot": "apps/h3_fl2va",
  "tags": ["type:app", "scope:worker", "model:h3-fl2va"],
  "targets": {
    "test-unit": {
      "executor": "@inference/workspace-plugin:pytest",
      "options": { "family": "h3_fl2va", "mode": "unit" },
      "inputs": ["default"],
      "cache": true
    },
    "test-e2e": {
      "executor": "@inference/workspace-plugin:pytest",
      "options": { "family": "h3_fl2va", "mode": "e2e" },
      "cache": false
    },
    "lint": {
      "executor": "@inference/workspace-plugin:ruff",
      "options": { "family": "h3_fl2va" },
      "cache": true
    },
    "typecheck": {
      "executor": "@inference/workspace-plugin:ty",
      "options": { "family": "h3_fl2va" },
      "cache": true
    },
    "verify-deploy-gate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run python -c \"from apps.h3_fl2va._shared_minimax_h3_turbo_fl2va import IMAGE_PIP_DEPS; print('\\n'.join(IMAGE_PIP_DEPS))\" | uv pip compile --python-version 3.11 -",
        "cwd": "."
      },
      "cache": true
    },
    "deploy-modal": {
      "executor": "nx:run-commands",
      "options": { "command": "echo 'uv run --locked modal deploy h3_fl2va/worker_modal_cls_*.py (turbo_fl2va)'", "cwd": "." },
      "dependsOn": ["verify-deploy-gate", "deploy-worker"],
      "cache": false
    },
    "deploy-beam": {
      "executor": "nx:run-commands",
      "options": { "command": "echo 'Beam deploys on dispatch.put(); see AGENTS.md'", "cwd": "." },
      "dependsOn": ["verify-deploy-gate", "deploy-worker"],
      "cache": false
    },
    "deploy-worker": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node deploy-worker.mjs",
        "cwd": "apps/h3_fl2va"
      },
      "dependsOn": ["worker-router:build"],
      "cache": false
    }
  }
}
