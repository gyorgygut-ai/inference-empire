{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "worker-krea2",
  "projectType": "application",
  "sourceRoot": "apps/krea2",
  "tags": [
    "type:app",
    "scope:gpu-worker",
    "model:krea2"
  ],
  "targets": {
    "dev-modal": {
      "executor": "orchestrator:run-command-with-artifact",
      "options": {
        "command": "uv run --locked python tools/serve-modal.py",
        "args": ["worker-krea2", "dev"],
        "artifact": "{workspaceRoot}/dist/worker-krea2/dev/MODAL_WORKER_URL"
      }
    },
    "dev-beam": {
      "executor": "orchestrator:run-command-with-artifact",
      "options": {
        "command": "uv run --locked python tools/serve-beam.py",
        "args": ["worker-krea2", "dev"],
        "artifact": "{workspaceRoot}/dist/worker-krea2/dev/BEAM_WORKER_URL"
      }
    },
    "dev-flash": {
      "executor": "orchestrator:run-command-with-artifact",
      "options": {
        "command": "uv run --locked python tools/serve-flash.py",
        "args": ["worker-krea2", "dev"],
        "artifact": "{workspaceRoot}/dist/worker-krea2/dev/FLASH_WORKER_URL"
      }
    },
    "deploy-modal": {
      "executor": "orchestrator:run-command-with-artifact",
      "options": {
        "command": "npx tsx tools/deploy-modal.ts",
        "args": ["worker-krea2", "deploy"],
        "artifact": "{workspaceRoot}/dist/worker-krea2/deploy/MODAL_WORKER_URL"
      }
    },
    "deploy-beam": {
      "executor": "orchestrator:run-command-with-artifact",
      "options": {
        "command": "npx tsx tools/deploy-beam.ts",
        "args": ["worker-krea2", "deploy"],
        "artifact": "{workspaceRoot}/dist/worker-krea2/deploy/BEAM_WORKER_URL"
      }
    },
    "deploy-flash": {
      "executor": "orchestrator:run-command-with-artifact",
      "options": {
        "command": "npx tsx tools/deploy-flash.ts",
        "args": ["worker-krea2", "deploy"],
        "artifact": "{workspaceRoot}/dist/worker-krea2/deploy/FLASH_WORKER_URL"
      }
    }
  }
}
