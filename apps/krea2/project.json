{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "krea2",
  "projectType": "application",
  "sourceRoot": "apps/krea2",
  "tags": [
    "type:app",
    "scope:worker",
    "model:krea2"
  ],
  "targets": {
    "test-unit": {
      "executor": "@inference/workspace-plugin:pytest",
      "options": {
        "family": "krea2",
        "mode": "unit"
      },
      "inputs": [
        "default"
      ],
      "cache": true
    },
    "test-e2e": {
      "executor": "@inference/workspace-plugin:pytest",
      "options": {
        "family": "krea2",
        "mode": "e2e"
      },
      "cache": false
    },
    "lint": {
      "executor": "@inference/workspace-plugin:ruff",
      "options": {
        "family": "krea2"
      },
      "cache": true
    },
    "typecheck": {
      "executor": "@inference/workspace-plugin:ty",
      "options": {
        "family": "krea2"
      },
      "cache": true
    }
  }
}
