{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "worker-krea2",
  "projectType": "application",
  "sourceRoot": "apps/krea2",
  "tags": ["type:app", "scope:gpu-worker", "model:krea2"],
  "targets": {
    "dev-modal": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "continuous": true,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/krea2/dev.env"],
      "options": {
        "command": "uv run --locked python tools/serve-modal.py",
        "args": "apps/krea2/worker_modal_cls_krea2_ref2img.py",
        "envFile": "dist/krea2/dev.env",
        "envKey": "MODAL_WORKER_URL"
      }
    },
    "dev-beam": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "continuous": true,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/krea2/dev.env"],
      "options": {
        "command": "uv run --locked python tools/serve-beam.py",
        "args": "apps/krea2/worker_beam_tq_krea2_ref2img.py",
        "envFile": "dist/krea2/dev.env",
        "envKey": "BEAM_WORKER_URL"
      }
    },
    "dev-flash": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "continuous": true,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/krea2/dev.env"],
      "options": {
        "command": "uv run --locked python tools/serve-flash.py",
        "args": "apps/krea2/worker_flash_cls_krea2_ref2img.py",
        "envFile": "dist/krea2/dev.env",
        "envKey": "FLASH_WORKER_URL"
      }
    },
    "deploy-modal": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/krea2/deploy.env"],
      "options": {
        "command": "npx tsx tools/deploy-modal.ts",
        "args": "apps/krea2/worker_modal_cls_krea2_ref2img.py",
        "envFile": "dist/krea2/deploy.env",
        "envKey": "MODAL_WORKER_URL"
      }
    },
    "deploy-beam": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/krea2/deploy.env"],
      "options": {
        "command": "npx tsx tools/deploy-beam.ts",
        "args": "apps/krea2/worker_beam_tq_krea2_ref2img.py",
        "envFile": "dist/krea2/deploy.env",
        "envKey": "BEAM_WORKER_URL"
      }
    },
    "deploy-flash": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/krea2/deploy.env"],
      "options": {
        "command": "npx tsx tools/deploy-flash.ts",
        "args": "apps/krea2/worker_flash_cls_krea2_ref2img.py",
        "envFile": "dist/krea2/deploy.env",
        "envKey": "FLASH_WORKER_URL"
      }
    }
  }
}
