{
  "input": {
    "title": "RealtimeVoiceInput",
    "required": ["type"],
    "properties": {
      "type": { "type": "string", "description": "Event type", "enum": ["session.update", "input_audio_buffer.append", "input_audio_buffer.commit", "input_audio_buffer.clear"] },
      "session": { "type": "object", "description": "Session config (for session.update)", "default": null },
      "audio": { "type": "string", "description": "Base64 audio chunk (for input_audio_buffer.append)", "default": null }
    }
  },
  "output": {
    "title": "RealtimeVoiceOutput",
    "required": ["type"],
    "properties": {
      "type": { "type": "string", "description": "Event type", "enum": ["session.created", "session.updated", "error", "response.audio.delta", "response.audio.done", "response.text.delta", "response.text.done", "conversation.item.created"] },
      "session": { "type": "object", "description": "Session state (for session.created/updated)", "default": null },
      "error": { "type": "object", "description": "Error details (for error events)", "default": null },
      "delta": { "type": "string", "description": "Base64 audio/text chunk (for deltas)", "default": null }
    }
  }
}
