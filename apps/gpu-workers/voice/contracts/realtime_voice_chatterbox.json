{
  "input": {
    "title": "ChatterboxTTSInput",
    "required": ["input", "voice"],
    "properties": {
      "input": { "type": "string", "description": "Text to synthesize" },
      "voice": { "type": "string", "description": "Reference voice ID", "default": "GutAI" },
      "model": { "type": "string", "description": "Model name (ignored, always Chatterbox)", "default": "chatterbox" },
      "response_format": { "type": "string", "description": "Output format", "default": "wav", "enum": ["wav"] }
    }
  },
  "output": {
    "title": "ChatterboxTTSOutput",
    "required": ["audio", "content_type"],
    "properties": {
      "audio": { "type": "string", "description": "Base64-encoded WAV audio bytes" },
      "content_type": { "type": "string", "enum": ["audio/wav"] }
    }
  }
}
