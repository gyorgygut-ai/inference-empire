{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "realtime-voice",
  "projectType": "application",
  "sourceRoot": "apps/realtime_voice",
  "tags": ["type:app", "scope:gpu-worker", "model:realtime-voice"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mkdir -p dist/apps/realtime-voice && cp -r apps/realtime_voice/* dist/apps/realtime-voice/",
        "cwd": "."
      },
      "cache": true
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "modal serve worker_modal_cls_realtime_voice_qwen.py",
        "cwd": "apps/realtime_voice"
      },
      "outputs": ["{projectRoot}/dist/dev-endpoint.json"],
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["deploy-modal", "deploy-beam", "deploy-flash"],
      "outputs": ["{projectRoot}/dist/deploy-endpoints.json"],
      "cache": false
    },
    "deploy-modal": {
      "executor": "@inference/deploy-worker:deploy-modal",
      "cache": false,
      "options": { "worker": "worker_modal_cls_realtime_voice_qwen.py" }
    },
    "deploy-beam": {
      "executor": "@inference/deploy-worker:deploy-beam",
      "cache": false,
      "options": { "worker": "worker_beam_asgi_realtime_voice_qwen.py", "name": "realtime-voice-qwen-worker", "entrypoint": "worker" }
    },
    "deploy-flash": {
      "executor": "@inference/deploy-worker:deploy-flash",
      "cache": false,
      "options": { "worker": "worker_flash_cls_realtime_voice_qwen.py" }
    }
  }
}
