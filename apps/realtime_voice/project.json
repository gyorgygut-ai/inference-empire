{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "realtime-voice",
  "projectType": "application",
  "sourceRoot": "apps/realtime_voice",
  "tags": ["type:app", "scope:gpu-worker", "model:realtime-voice"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mkdir -p dist/apps/realtime-voice && cp -r apps/realtime_voice/* dist/apps/realtime-voice/",
        "cwd": "."
      },
      "cache": true
    },
    "deploy-modal": {
      "executor": "@inference/workspace-plugin:deploy-modal",
      "cache": false,
      "options": { "worker": "worker_modal_cls_realtime_voice_qwen.py" }
    },
    "deploy-beam": {
      "executor": "@inference/workspace-plugin:deploy-beam",
      "cache": false,
      "options": { "worker": "worker_beam_asgi_realtime_voice_qwen.py", "name": "realtime-voice-qwen-worker", "entrypoint": "worker" }
    },
    "deploy-flash": {
      "executor": "@inference/workspace-plugin:deploy-flash",
      "cache": false,
      "options": { "worker": "worker_flash_cls_realtime_voice_qwen.py" }
    }
  }
}
