{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "worker-realtime_voice",
  "projectType": "application",
  "sourceRoot": "apps/realtime_voice",
  "tags": ["type:app", "scope:gpu-worker", "model:realtime-voice"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mkdir -p dist/apps/realtime-voice && cp -r apps/realtime_voice/* dist/apps/realtime-voice/",
        "cwd": "."
      },
      "cache": true
    },
    "dev-modal": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "continuous": true,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/realtime_voice/dev.env"],
      "options": {
        "command": "uv run --locked python tools/serve-modal.py",
        "args": "apps/realtime_voice/worker_modal_cls_realtime_voice_qwen.py",
        "envFile": "dist/realtime_voice/dev.env",
        "envKey": "MODAL_WORKER_URL"
      }
    },
    "dev-beam": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "continuous": true,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/realtime_voice/dev.env"],
      "options": {
        "command": "uv run --locked python tools/serve-beam.py",
        "args": "apps/realtime_voice/worker_beam_asgi_realtime_voice_qwen.py",
        "envFile": "dist/realtime_voice/dev.env",
        "envKey": "BEAM_WORKER_URL"
      }
    },
    "dev-flash": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "continuous": true,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/realtime_voice/dev.env"],
      "options": {
        "command": "uv run --locked python tools/serve-flash.py",
        "args": "apps/realtime_voice/worker_flash_cls_realtime_voice_qwen.py",
        "envFile": "dist/realtime_voice/dev.env",
        "envKey": "FLASH_WORKER_URL"
      }
    },
    "deploy-modal": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/realtime_voice/deploy.env"],
      "options": {
        "command": "npx tsx tools/deploy-modal.ts",
        "args": "apps/realtime_voice/worker_modal_cls_realtime_voice_qwen.py",
        "envFile": "dist/realtime_voice/deploy.env",
        "envKey": "MODAL_WORKER_URL"
      }
    },
    "deploy-beam": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/realtime_voice/deploy.env"],
      "options": {
        "command": "npx tsx tools/deploy-beam.ts",
        "args": "apps/realtime_voice/worker_beam_asgi_realtime_voice_qwen.py",
        "envFile": "dist/realtime_voice/deploy.env",
        "envKey": "BEAM_WORKER_URL"
      }
    },
    "deploy-flash": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/realtime_voice/deploy.env"],
      "options": {
        "command": "npx tsx tools/deploy-flash.ts",
        "args": "apps/realtime_voice/worker_flash_cls_realtime_voice_qwen.py",
        "envFile": "dist/realtime_voice/deploy.env",
        "envKey": "FLASH_WORKER_URL"
      }
    }
  }
}
