{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "realtime-voice",
  "projectType": "application",
  "sourceRoot": "apps/realtime_voice",
  "tags": ["type:app", "scope:gpu-worker", "model:realtime-voice"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mkdir -p dist/apps/realtime-voice && cp -r apps/realtime_voice/* dist/apps/realtime-voice/",
        "cwd": "."
      },
      "cache": true
    },
    "deploy-modal": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx nx run realtime-voice:build",
        "cwd": "."
      }
    },
    "deploy-beam": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx nx run realtime-voice:build",
        "cwd": "."
      }
    },
    "deploy-flash": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx nx run realtime-voice:build",
        "cwd": "."
      }
    }
  }
}
