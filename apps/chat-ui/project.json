{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "chat-ui",
  "projectType": "application",
  "sourceRoot": "apps/chat-ui/src",
  "tags": ["type:app", "scope:client"],
  "implicitDependencies": ["infra-router", "worker-router"],
  "targets": {
    "build-manifest": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/build-manifest.mjs",
        "cwd": "apps/chat-ui"
      },
      "inputs": [
        "{workspaceRoot}/apps/gpu-workers/*/contracts/*.json",
        "{workspaceRoot}/apps/gpu-workers/**/worker_*.py"
      ],
      "outputs": ["{projectRoot}/src/lib/manifest.json"],
      "cache": true
    },
    "build": {
      "executor": "@nx/next:build",
      "options": {
        "outputPath": "{projectRoot}/.next"
      },
      "dependsOn": ["build-manifest", { "projects": ["worker-router"], "target": "build-manifest" }],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/.next"],
      "cache": true
    },
    "dev": {
      "executor": "@nx/next:dev",
      "options": {
        "port": 4200
      },
      "cache": false,
      "persistent": true
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "inputs": ["default", "{workspaceRoot}/eslint.config.mjs"],
      "cache": true
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'chat-ui: no host yet'",
        "cwd": "apps/chat-ui"
      },
      "dependsOn": ["^deploy", "build"],
      "cache": false
    }
  }
}
