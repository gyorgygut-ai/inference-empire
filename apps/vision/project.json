{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "worker-vision",
  "projectType": "application",
  "sourceRoot": "apps/vision",
  "tags": ["type:app", "scope:gpu-worker", "model:vision"],
  "targets": {
    "dev-modal": {
      "executor": "@inference/deploy-worker:dev-modal",
      "cache": false,
      "persistent": true,
      "options": { "worker": "worker_modal_cls_small_vision.py" }
    },
    "dev-beam": {
      "executor": "@inference/deploy-worker:dev-beam",
      "cache": false,
      "persistent": true,
      "options": { "worker": "worker_beam_tq_small_vision.py", "entrypoint": "dispatch" }
    },
    "dev-flash": {
      "executor": "@inference/deploy-worker:dev-flash",
      "cache": false,
      "persistent": true,
      "options": { "worker": "worker_flash_cls_small_vision.py" }
    },
    "dev": {
      "executor": "nx:noop",
      "dependsOn": ["dev-modal", "dev-beam", "dev-flash"],
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["deploy-modal", "deploy-beam", "deploy-flash"],
      "outputs": ["{projectRoot}/dist/deploy-endpoints.json"],
      "cache": false
    },
    "deploy-modal": {
      "executor": "@inference/deploy-worker:deploy-modal",
      "cache": false,
      "options": { "worker": "worker_modal_cls_small_vision.py" }
    },
    "deploy-beam": {
      "executor": "@inference/deploy-worker:deploy-beam",
      "cache": false,
      "options": { "worker": "worker_beam_tq_small_vision.py", "name": "small-vision", "entrypoint": "dispatch" }
    },
    "deploy-flash": {
      "executor": "@inference/deploy-worker:deploy-flash",
      "cache": false,
      "options": { "worker": "worker_flash_cls_small_vision.py" }
    }
  }
}
