{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "beni",
  "projectType": "application",
  "sourceRoot": "apps/beni",
  "tags": ["type:app", "scope:beni"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "dependsOn": [
        {
          "projects": ["router"],
          "target": "router-krea2",
          "params": "forward"
        }
      ],
      "options": {
        "cwd": "apps/beni",
        "command": "npx vite --port 4300 --strictPort"
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{workspaceRoot}/dist/beni"],
      "options": {
        "configFile": "apps/beni/vite.config.ts",
        "outputPath": "dist/beni"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/beni",
        "command": "npx vitest run"
      }
    }
  }
}
