{
  "name": "functions",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/functions/src",
  "targets": {
    "predev": {
      "executor": "nx:noop",
      "dependsOn": [
        "prebuild"
      ]
    },
    "prebuild": {
      "executor": "nx:noop",
      "dependsOn": [
        "^prebuild",
        "generate-*"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "prebuild"
      ],
      "cache": true,
      "options": {
        "command": "echo 'no build step'"
      }
    },
    "generate-flux2-dev-auth-token": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": [
        "{workspaceRoot}/packages/contracts/task-queue-service/flux2-dev.contract.ts"
      ],
      "options": {
        "command": "npx tsx tools/generate-auth-token.ts"
      }
    },
    "generate-flux2-deploy-auth-token": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": [
        "{workspaceRoot}/packages/contracts/task-queue-service/flux2-deploy.contract.ts"
      ],
      "options": {
        "command": "npx tsx tools/generate-auth-token.ts",
        "siteId": "cd41f060-bbdf-49fa-82a6-20d7ba136853"
      }
    },
    "generate-krea2-dev-auth-token": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": [
        "{workspaceRoot}/packages/contracts/task-queue-service/krea2-dev.contract.ts"
      ],
      "options": {
        "command": "npx tsx tools/generate-auth-token.ts"
      }
    },
    "generate-krea2-deploy-auth-token": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": [
        "{workspaceRoot}/packages/contracts/task-queue-service/krea2-deploy.contract.ts"
      ],
      "options": {
        "command": "npx tsx tools/generate-auth-token.ts",
        "siteId": "cd41f060-bbdf-49fa-82a6-20d7ba136853"
      }
    },
    "dev-flux2": {
      "executor": "orchestrator:run-command",
      "continuous": true,
      "cache": false,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": [
        "predev",
        "workers-flux2:deploy-beam"
      ],
      "inputs": [
        "{workspaceRoot}/packages/contracts/worker-service/flux2-deploy.contract.ts",
        "{workspaceRoot}/packages/contracts/task-queue-service/flux2-dev.contract.ts"
      ],
      "options": {
        "command": "GENERATED_AUTH_TOKEN=$ROUTER_GENERATED_AUTH_TOKEN npx tsx tools/serve-netlify-functions.ts",
        "args": "--port 4000"
      }
    },
    "dev-krea2": {
      "executor": "orchestrator:run-command",
      "continuous": true,
      "cache": false,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": [
        "predev",
        "workers-krea2:deploy-beam"
      ],
      "inputs": [
        "{workspaceRoot}/packages/contracts/worker-service/krea2-deploy.contract.ts",
        "{workspaceRoot}/packages/contracts/task-queue-service/krea2-dev.contract.ts"
      ],
      "options": {
        "command": "GENERATED_AUTH_TOKEN=$ROUTER_GENERATED_AUTH_TOKEN npx tsx tools/serve-netlify-functions.ts",
        "args": "--port 4025"
      }
    },
    "deploy-flux2": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "dependsOn": [
        "prebuild",
        "workers-flux2:deploy-beam"
      ],
      "inputs": [
        "{workspaceRoot}/packages/contracts/worker-service/flux2-deploy.contract.ts",
        "{workspaceRoot}/packages/contracts/task-queue-service/flux2-deploy.contract.ts"
      ],
      "options": {
        "command": "WORKER_URL_BEAM=$WORKER_RESOLVED_BEAM_URL GENERATED_AUTH_TOKEN=$ROUTER_GENERATED_AUTH_TOKEN npx netlify deploy",
        "args": "--site={options.siteId}",
        "siteId": "cd41f060-bbdf-49fa-82a6-20d7ba136853"
      }
    },
    "deploy-krea2": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "dependsOn": [
        "prebuild",
        "workers-krea2:deploy-beam"
      ],
      "inputs": [
        "{workspaceRoot}/packages/contracts/worker-service/krea2-deploy.contract.ts",
        "{workspaceRoot}/packages/contracts/task-queue-service/krea2-deploy.contract.ts"
      ],
      "options": {
        "command": "WORKER_URL_BEAM=$WORKER_RESOLVED_BEAM_URL GENERATED_AUTH_TOKEN=$ROUTER_GENERATED_AUTH_TOKEN npx netlify deploy",
        "args": "--site={options.siteId}",
        "siteId": "cd41f060-bbdf-49fa-82a6-20d7ba136853"
      }
    }
  }
}