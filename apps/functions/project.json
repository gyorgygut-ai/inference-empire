{
  "name": "functions",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/functions/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "dist/apps/functions",
        "format": [
          "cjs"
        ],
        "bundle": false,
        "main": "apps/functions/src/main.ts",
        "tsConfig": "apps/functions/tsconfig.app.json",
        "assets": [
          "apps/functions/src/assets"
        ],
        "generatePackageJson": true,
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          }
        }
      },
      "configurations": {
        "development": {},
        "production": {
          "esbuildOptions": {
            "sourcemap": false,
            "outExtension": {
              ".js": ".js"
            }
          }
        }
      },
      "dependsOn": [
        "prebuild"
      ]
    },
    "prune-lockfile": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/functions/package.json",
        "{workspaceRoot}/dist/apps/functions/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/functions/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": [
        "prune-lockfile",
        "copy-workspace-modules"
      ],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "functions:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "functions:build:development"
        },
        "production": {
          "buildTarget": "functions:build:production"
        }
      }
    },
    "serve-functions": {
      "command": "npx netlify dev",
      "options": {
        "cwd": "apps/functions"
      }
    },
    "deploy-functions": {
      "dependsOn": [],
      "command": "npx netlify deploy --site=cd41f060-bbdf-49fa-82a6-20d7ba136853",
      "options": {
        "cwd": "apps/functions"
      },
      "configurations": {
        "production": {
          "command": "npx netlify deploy --prod --site=cd41f060-bbdf-49fa-82a6-20d7ba136853",
          "cwd": "apps/functions"
        }
      }
    },
    "prebuild": {
      "executor": "nx:noop",
      "dependsOn": [
        "^prebuild",
        "generate-*"
      ]
    },
    "predev": {
      "executor": "nx:noop",
      "dependsOn": [
        "prebuild"
      ]
    },
    "generate-flux2-dev-auth-token": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "npx tsx tools/generate-auth-token.ts",
        "fulfills": [
          {
            "contract": "task-queue-service/flux2-dev",
            "contractKey": "ROUTER_GENERATED_AUTH_TOKEN"
          }
        ]
      }
    },
    "generate-flux2-deploy-auth-token": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "npx tsx tools/generate-auth-token.ts",
        "fulfills": [
          {
            "contract": "task-queue-service/flux2-deploy",
            "contractKey": "ROUTER_GENERATED_AUTH_TOKEN"
          }
        ]
      }
    },
    "dev-flux2": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "dependsOn": [
        "predev",
        "workers-flux2:deploy-beam"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "npx tsx tools/serve-netlify-functions.ts",
        "needs": [
          {
            "contract": "worker-service/flux2-deploy"
          },
          {
            "contract": "task-queue-service/flux2-dev",
            "contractKey": "ROUTER_GENERATED_AUTH_TOKEN"
          }
        ],
        "fulfills": [
          {
            "contract": "task-queue-service/flux2-dev",
            "contractKey": "ROUTER_RESOLVED_URL"
          }
        ]
      }
    },
    "deploy-flux2": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "dependsOn": [
        "build",
        "workers-flux2:deploy-beam"
      ],
      "options": {
        "cwd": "apps/functions",
        "command": "npx netlify deploy --prod --json --site=cd41f060-bbdf-49fa-82a6-20d7ba136853 | node -p \"JSON.parse(require('fs').readFileSync(0,'utf8')).url\"",
        "needs": [
          {
            "contract": "worker-service/flux2-deploy"
          },
          {
            "contract": "task-queue-service/flux2-deploy",
            "contractKey": "ROUTER_GENERATED_AUTH_TOKEN"
          }
        ],
        "fulfills": [
          {
            "contract": "task-queue-service/flux2-deploy",
            "contractKey": "ROUTER_RESOLVED_URL"
          }
        ]
      }
    },
    "generate-krea2-dev-auth-token": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "npx tsx tools/generate-auth-token.ts",
        "fulfills": [
          {
            "contract": "task-queue-service/krea2-dev",
            "contractKey": "ROUTER_GENERATED_AUTH_TOKEN"
          }
        ]
      }
    },
    "generate-krea2-deploy-auth-token": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "npx tsx tools/generate-auth-token.ts",
        "fulfills": [
          {
            "contract": "task-queue-service/krea2-deploy",
            "contractKey": "ROUTER_GENERATED_AUTH_TOKEN"
          }
        ]
      }
    },
    "dev-krea2": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "dependsOn": [
        "predev"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "npx tsx tools/serve-netlify-functions.ts",
        "needs": [
          {
            "contract": "worker-service/krea2-dev"
          },
          {
            "contract": "task-queue-service/krea2-dev",
            "contractKey": "ROUTER_GENERATED_AUTH_TOKEN"
          }
        ],
        "fulfills": [
          {
            "contract": "task-queue-service/krea2-dev",
            "contractKey": "ROUTER_RESOLVED_URL"
          }
        ]
      }
    },
    "deploy-krea2": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "apps/functions",
        "command": "npx netlify deploy --prod --json --site=cd41f060-bbdf-49fa-82a6-20d7ba136853 | node -p \"JSON.parse(require('fs').readFileSync(0,'utf8')).url\"",
        "needs": [
          {
            "contract": "worker-service/krea2-deploy"
          },
          {
            "contract": "task-queue-service/krea2-deploy",
            "contractKey": "ROUTER_GENERATED_AUTH_TOKEN"
          }
        ],
        "fulfills": [
          {
            "contract": "task-queue-service/krea2-deploy",
            "contractKey": "ROUTER_RESOLVED_URL"
          }
        ]
      }
    }
  }
}
