{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "workers-vision",
  "projectType": "application",
  "sourceRoot": "apps/workers/vision",
  "tags": [
    "type:app",
    "scope:gpu-worker",
    "model:vision"
  ],
  "targets": {
    "deploy-modal": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "SECRET_HUGGINGFACE_TOKEN": "${SECRET_HUGGINGFACE_TOKEN}",
          "SECRET_R2_ACCESS_KEY": "${SECRET_R2_ACCESS_KEY}",
          "SECRET_R2_SECRET_KEY": "${SECRET_R2_SECRET_KEY}",
          "SECRET_R2_ENDPOINT": "${SECRET_R2_ENDPOINT}",
          "SECRET_R2_BUCKET": "${SECRET_R2_BUCKET}",
          "BEAM_TOKEN": "${SECRET_BEAM_TOKEN}",
          "MODAL_TOKEN_ID": "${SECRET_MODAL_TOKEN_ID}",
          "MODAL_TOKEN_SECRET": "${SECRET_MODAL_TOKEN_SECRET}"
        },
        "command": "uv run --locked --project ../../../ modal deploy",
        "args": "worker_vision_modal.py"
      },
      "dependsOn": [
        "predeploy"
      ]
    },
    "deploy-beam": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "PYTHONPATH": ".",
          "SECRET_HUGGINGFACE_TOKEN": "${SECRET_HUGGINGFACE_TOKEN}",
          "SECRET_R2_ACCESS_KEY": "${SECRET_R2_ACCESS_KEY}",
          "SECRET_R2_SECRET_KEY": "${SECRET_R2_SECRET_KEY}",
          "SECRET_R2_ENDPOINT": "${SECRET_R2_ENDPOINT}",
          "SECRET_R2_BUCKET": "${SECRET_R2_BUCKET}",
          "BEAM_TOKEN": "${SECRET_BEAM_TOKEN}"
        },
        "command": "uv run --locked --project ../../../ beam deploy",
        "args": "worker_vision_beam.py:generate"
      },
      "dependsOn": [
        "predeploy"
      ]
    },
    "deploy": {
      "executor": "nx:noop",
      "dependsOn": [
        "deploy-modal",
        "deploy-beam"
      ],
      "cache": false
    },
    "predeploy": {
      "executor": "nx:noop",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/packages/schemas/workers/vision.schema.json",
        "{workspaceRoot}/packages/schemas/tools/generate_pydantic.py",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock"
      ],
      "outputs": [
        "{projectRoot}/dist/contract_vision.py"
      ],
      "dependsOn": [
        {
          "projects": [
            "schemas"
          ],
          "target": "build-pydantic",
          "options": "forward"
        }
      ],
      "options": {
        "source": "packages/schemas/workers/vision.schema.json",
        "out": "apps/workers/vision/dist/contract_vision.py"
      }
    }
  }
}
