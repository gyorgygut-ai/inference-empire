{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "worker-llm",
  "projectType": "application",
  "sourceRoot": "apps/workers/llm",
  "tags": ["type:app", "scope:gpu-worker", "model:llm"],
  "targets": {
    "stub-beam": {
      "executor": "dotenvx:run-commands",
      "continuous": true,
      "cache": false,
      "readyWhen": { "url": "http://127.0.0.1:18762/health" },
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "SECRET_LLM_CHAT_COMPLETIONS_API_KEY": "${GENERATED_LLM_CHAT_COMPLETIONS_API_KEY}"
        },
        "command": "uv run --locked --project ../../../ uvicorn",
        "args": "fakes.worker_llm_chat_completions_beam:app --host 127.0.0.1 --port 18762"
      }
    },
    "deploy-beam": {
      "executor": "dotenvx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/worker_llm_chat_completions_beam.py",
        "{projectRoot}/shared/**/*.py",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock",
        "{workspaceRoot}/packages/schemas/workers/voice_llm_chat_completions.schema.json",
        "{workspaceRoot}/packages/schemas/tools/generate_pydantic.py",
        { "env": "SECRET_HUGGINGFACE_TOKEN" },
        { "env": "SECRET_BEAM_TOKEN" }
      ],
      "outputs": [],
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "PYTHONPATH": ".",
          "SECRET_HUGGINGFACE_TOKEN": "${SECRET_HUGGINGFACE_TOKEN}",
          "SECRET_LLM_CHAT_COMPLETIONS_API_KEY": "${GENERATED_LLM_CHAT_COMPLETIONS_API_KEY}",
          "BEAM_TOKEN": "${SECRET_BEAM_TOKEN}"
        },
        "command": "uv run --locked --project ../../../ beam deploy",
        "args": "worker_llm_chat_completions_beam.py:generate"
      },
      "dependsOn": ["prebuild"]
    },
    "deploy": {
      "executor": "nx:noop",
      "dependsOn": ["deploy-beam"],
      "cache": false
    },
    "prebuild": {
      "executor": "nx:noop",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/packages/schemas/workers/voice_llm_chat_completions.schema.json",
        "{workspaceRoot}/packages/schemas/tools/generate_pydantic.py",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock"
      ],
      "outputs": ["{projectRoot}/dist/contract_llm_chat_completions.py"],
      "dependsOn": [{"projects": ["schemas"], "target": "build-pydantic", "options": "forward"}],
      "options": {
        "source": "packages/schemas/workers/voice_llm_chat_completions.schema.json",
        "out": "apps/workers/llm/dist/contract_llm_chat_completions.py"
      }
    },
    "test-unit": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": ["prebuild"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "uv run --locked pytest",
        "args": "tests/unit/test_llm_chat_completions_unit.py"
      }
    },
    "test-acceptance": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": ["deploy-beam"],
      "options": {
        "cwd": "{workspaceRoot}",
        "env": {
          "LLM_CHAT_COMPLETIONS_API_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts worker-llm)"
        },
        "command": "uv run --locked --project apps/workers/llm python",
        "args": "apps/workers/llm/tests/acceptance_llm_chat_completions.py"
      }
    }
  }
}
