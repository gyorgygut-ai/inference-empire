{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "worker-flux2",
  "projectType": "application",
  "sourceRoot": "apps/workers/flux2",
  "tags": [
    "type:app",
    "scope:gpu-worker",
    "model:flux2"
  ],
  "targets": {
    "deploy-modal": {
      "executor": "dotenvx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/worker_flux2_modal.py",
        "{projectRoot}/shared/**/*.py",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock",
        "{workspaceRoot}/packages/schemas/workers/flux2.schema.json",
        "{workspaceRoot}/packages/schemas/tools/generate_pydantic.py",
        { "env": "SECRET_HUGGINGFACE_TOKEN" },
        { "env": "SECRET_R2_ACCESS_KEY" },
        { "env": "SECRET_R2_SECRET_KEY" },
        { "env": "SECRET_R2_ENDPOINT" },
        { "env": "SECRET_R2_BUCKET" },
        { "env": "SECRET_BEAM_TOKEN" },
        { "env": "SECRET_MODAL_TOKEN_ID" },
        { "env": "SECRET_MODAL_TOKEN_SECRET" }
      ],
      "outputs": [],
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "SECRET_HUGGINGFACE_TOKEN": "${SECRET_HUGGINGFACE_TOKEN}",
          "SECRET_R2_ACCESS_KEY": "${SECRET_R2_ACCESS_KEY}",
          "SECRET_R2_SECRET_KEY": "${SECRET_R2_SECRET_KEY}",
          "SECRET_R2_ENDPOINT": "${SECRET_R2_ENDPOINT}",
          "SECRET_R2_BUCKET": "${SECRET_R2_BUCKET}",
          "BEAM_TOKEN": "${SECRET_BEAM_TOKEN}",
          "MODAL_TOKEN_ID": "${SECRET_MODAL_TOKEN_ID}",
          "MODAL_TOKEN_SECRET": "${SECRET_MODAL_TOKEN_SECRET}"
        },
        "command": "uv run --locked --project ../../../ modal deploy",
        "args": "worker_flux2_modal.py"
      },
      "dependsOn": [
        "prebuild"
      ]
    },
    "deploy-beam": {
      "executor": "dotenvx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/worker_flux2_beam.py",
        "{projectRoot}/shared/**/*.py",
        "{projectRoot}/beam.yaml",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock",
        "{workspaceRoot}/packages/schemas/workers/flux2.schema.json",
        "{workspaceRoot}/packages/schemas/tools/generate_pydantic.py",
        { "env": "SECRET_HUGGINGFACE_TOKEN" },
        { "env": "SECRET_R2_ACCESS_KEY" },
        { "env": "SECRET_R2_SECRET_KEY" },
        { "env": "SECRET_R2_ENDPOINT" },
        { "env": "SECRET_R2_BUCKET" },
        { "env": "SECRET_BEAM_TOKEN" }
      ],
      "outputs": [],
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "PYTHONPATH": ".",
          "SECRET_HUGGINGFACE_TOKEN": "${SECRET_HUGGINGFACE_TOKEN}",
          "SECRET_R2_ACCESS_KEY": "${SECRET_R2_ACCESS_KEY}",
          "SECRET_R2_SECRET_KEY": "${SECRET_R2_SECRET_KEY}",
          "SECRET_R2_ENDPOINT": "${SECRET_R2_ENDPOINT}",
          "SECRET_R2_BUCKET": "${SECRET_R2_BUCKET}",
          "BEAM_TOKEN": "${SECRET_BEAM_TOKEN}"
        },
        "command": "uv run --locked --project ../../../ beam deploy",
        "args": "worker_flux2_beam.py:generate"
      },
      "dependsOn": [
        "prebuild"
      ]
    },
    "deploy": {
      "executor": "nx:noop",
      "dependsOn": [
        "deploy-modal",
        "deploy-beam"
      ],
      "cache": false
    },
    "prebuild": {
      "executor": "nx:noop",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/packages/schemas/workers/flux2.schema.json",
        "{workspaceRoot}/packages/schemas/tools/generate_pydantic.py",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock"
      ],
      "outputs": [
        "{projectRoot}/dist/contract_flux2.py"
      ],
      "dependsOn": [
        {
          "projects": [
            "schemas"
          ],
          "target": "build-pydantic",
          "options": "forward"
        }
      ],
      "options": {
        "source": "packages/schemas/workers/flux2.schema.json",
        "out": "apps/workers/flux2/dist/contract_flux2.py"
      }
    }
  }
}
