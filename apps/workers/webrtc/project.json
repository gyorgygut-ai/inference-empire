{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "worker-webrtc",
  "projectType": "application",
  "sourceRoot": "apps/workers/webrtc/src",
  "tags": ["type:app", "scope:realtime"],
  "targets": {
    "dev": {
      "executor": "dotenvx:run-commands",
      "continuous": true,
      "cache": false,
      "dependsOn": ["prebuild"],
      "readyWhen": {
        "url": "http://127.0.0.1:{env.DEV_WEBRTC_WORKER_PORT}"
      },
      "options": {
        "cwd": "{workspaceRoot}",
        "env": {
          "PORT": "${DEV_WEBRTC_WORKER_PORT}",
          "SECRET_HUGGINGFACE_TOKEN": "${SECRET_HUGGINGFACE_TOKEN}"
        },
        "command": "npx tsx apps/workers/webrtc/src/server.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "npx oxlint apps/workers/webrtc"
      }
    },
    "test-unit": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": ["prebuild"],
      "options": {
        "cwd": "{workspaceRoot}",
        "env": {
          "PORT": "${DEV_WEBRTC_WORKER_PORT}",
          "SECRET_HUGGINGFACE_TOKEN": "${SECRET_HUGGINGFACE_TOKEN}"
        },
        "command": "npx vitest run --config apps/workers/webrtc/vitest.config.ts"
      }
    },
    "test-unit:watch": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": ["prebuild"],
      "options": {
        "cwd": "{workspaceRoot}",
        "env": {
          "PORT": "${DEV_WEBRTC_WORKER_PORT}",
          "SECRET_HUGGINGFACE_TOKEN": "${SECRET_HUGGINGFACE_TOKEN}"
        },
        "command": "npx vitest --config apps/workers/webrtc/vitest.config.ts"
      }
    },
    "prebuild": {
      "executor": "nx:noop",
      "cache": true,
      "inputs": ["{workspaceRoot}/packages/schemas/workers/webrtc.schema.json"],
      "outputs": ["{projectRoot}/dist/webrtc.schema.ts"],
      "dependsOn": [
        { "projects": ["schemas"], "target": "build-ts", "options": "forward" }
      ],
      "options": {
        "source": "packages/schemas/workers/webrtc.schema.json",
        "out": "apps/workers/webrtc/dist/webrtc.schema.ts"
      }
    }
  }
}
