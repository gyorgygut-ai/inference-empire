{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "workers-krea2",
  "projectType": "application",
  "sourceRoot": "apps/workers/krea2",
  "tags": ["type:app", "scope:gpu-worker", "model:krea2"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "{projectRoot}/**/*.py",
        "{projectRoot}/pyproject.toml",
        "{projectRoot}/uv.lock",
        "{workspaceRoot}/packages/workers/**/*",
        "{workspaceRoot}/tools/uv-build"
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "python3 tools/uv-build {args.entry} {args.out}"
      },
      "configurations": {
        "modal": {
          "entry": "apps/workers/krea2/worker_modal_cls_krea2_ref2img.py",
          "out": "apps/workers/krea2/dist/modal"
        },
        "beam": {
          "entry": "apps/workers/krea2/worker_beam_tq_krea2_ref2img.py",
          "out": "apps/workers/krea2/dist/beam"
        },
        "flash": {
          "entry": "apps/workers/krea2/worker_flash_cls_krea2_ref2img.py",
          "out": "apps/workers/krea2/dist/flash"
        }
      }
    },
    "deploy-modal": {
      "executor": "nx:run-commands",
      "dependsOn": ["build:modal"],
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "MODAL_ENV_FILE=.env PYTHONPATH=. uv run --project . modal deploy apps/workers/krea2/dist/modal/worker_modal_cls_krea2_ref2img.py && echo \"WORKER_URL_MODAL=$(modal app get workers-krea2 --query url)\" >> dist/deploy/krea2/workers.env"
      }
    },
    "deploy-beam": {
      "executor": "nx:run-commands",
      "dependsOn": ["build:beam"],
      "cache": false,
      "options": {
        "cwd": "{projectRoot}/dist/beam",
        "command": "uv run --project ../../../../.. beam deploy worker_beam_tq_krea2_ref2img.py:dispatch && echo \"WORKER_URL_BEAM=$(beam app get workers-krea2 --query url)\" >> ../../../../dist/deploy/krea2/workers.env"
      }
    },
    "deploy-flash": {
      "executor": "nx:run-commands",
      "dependsOn": ["build:flash"],
      "cache": false,
      "options": {
        "cwd": "{projectRoot}/dist/flash",
        "command": "uv run --project ../../../../.. flash deploy worker_flash_cls_krea2_ref2img.py && echo \"WORKER_URL_FLASH=$(flash app get workers-krea2 --query url)\" >> ../../../../dist/deploy/krea2/workers.env"
      }
    }
  }
}
