{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "workers-krea2",
  "projectType": "application",
  "sourceRoot": "apps/workers/krea2",
  "tags": ["type:app", "scope:gpu-worker", "model:krea2"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "modal",
      "cache": false,
      "inputs": [
        "{projectRoot}/**/*.py",
        "{projectRoot}/pyproject.toml",
        "{projectRoot}/uv.lock",
        "{workspaceRoot}/packages/workers/**/*",
        "{workspaceRoot}/tools/uv-build"
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "python3 tools/uv-build {args.entry} {args.out}"
      },
      "configurations": {
        "modal": { "entry": "apps/workers/krea2/worker_modal_cls_krea2_ref2img.py", "out": "apps/workers/krea2/dist/modal" },
        "beam": { "entry": "apps/workers/krea2/worker_beam_tq_krea2_ref2img.py", "out": "apps/workers/krea2/dist/beam" }
      }
    },
    "build-beam": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "{projectRoot}/**/*.py",
        "{projectRoot}/pyproject.toml",
        "{projectRoot}/uv.lock",
        "{workspaceRoot}/packages/workers/**/*",
        "{workspaceRoot}/tools/uv-build"
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": { "cwd": "{workspaceRoot}", "command": "python3 tools/uv-build apps/workers/krea2/worker_beam_tq_krea2_ref2img.py apps/workers/krea2/dist/beam" }
    },
    "deploy-modal": {
      "executor": "orchestrator:run-command",
      "dependsOn": ["build"],
      "cache": false,
      "options": { "cwd": "{workspaceRoot}", "command": "npx tsx tools/deploy-modal.ts", "args": "apps/workers/krea2/dist/modal/worker_modal_cls_krea2_ref2img.py" }
    },
    "deploy-beam": {
      "executor": "orchestrator:run-command",
      "dependsOn": ["build-beam"],
      "cache": false,
      "options": { "cwd": "{workspaceRoot}", "command": "npx tsx tools/deploy-beam.ts", "args": "apps/workers/krea2/dist/beam/worker_beam_tq_krea2_ref2img.py" }
    }
  }
}
