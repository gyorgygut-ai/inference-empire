{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "workers-fastrtc_voice",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "modal",
      "cache": false,
      "inputs": ["{projectRoot}/**/*.py", "{projectRoot}/pyproject.toml", "{projectRoot}/uv.lock", "{workspaceRoot}/tools/uv-build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "python3 tools/uv-build {args.entry} {args.out}"
      },
      "configurations": {
        "modal": {
          "entry": "apps/workers/fastrtc_voice/worker_fastrtc_voice_modal.py",
          "out": "apps/workers/fastrtc_voice/dist/modal"
        },
        "beam": {
          "entry": "apps/workers/fastrtc_voice/worker_fastrtc_voice_beam.py",
          "out": "apps/workers/fastrtc_voice/dist/beam"
        }
      }
    },
    "deploy-modal": {
      "executor": "orchestrator:run-command",
      "dependsOn": ["build:modal"],
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "uv run --project apps/workers/fastrtc_voice --locked modal deploy apps/workers/fastrtc_voice/dist/modal/worker_fastrtc_voice_modal.py && npx tsx tools/orchestrator/src/get-modal-url.ts workers-fastrtc_voice"
      }
    },
    "deploy-beam": {
      "executor": "orchestrator:run-command",
      "dependsOn": ["build:beam"],
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}/apps/workers/fastrtc_voice/dist/beam",
        "command": "uv run --project ../.. --locked beam deploy worker_fastrtc_voice_beam.py:web && npx tsx ../../../../../tools/orchestrator/src/get-beam-url.ts workers-fastrtc_voice"
      }
    },
    "test-unit": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "uv run --locked pytest tests/ -k \"not e2e\" -q"
      }
    },
    "test-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "uv run --locked pytest tests/ -k \"e2e\" -q"
      }
    }
  }
}
