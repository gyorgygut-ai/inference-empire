{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "worker-stt",
  "projectType": "application",
  "sourceRoot": "apps/workers/stt",
  "tags": [
    "type:app",
    "scope:gpu-worker",
    "model:stt"
  ],
  "targets": {
    "stub-beam": {
      "executor": "dotenvx:run-commands",
      "continuous": true,
      "cache": false,
      "readyWhen": { "url": "http://127.0.0.1:18761/health" },
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "SECRET_STT_AUDIO_TRANSCRIPTIONS_API_KEY": "${GENERATED_STT_AUDIO_TRANSCRIPTIONS_API_KEY}"
        },
        "command": "uv run --locked --project ../../../ uvicorn",
        "args": "fakes.worker_stt_audio_transcriptions_beam:app --host 127.0.0.1 --port 18761"
      }
    },
    "deploy-beam": {
      "executor": "dotenvx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/worker_stt_audio_transcriptions_beam.py",
        "{projectRoot}/shared/**/*.py",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock",
        "{workspaceRoot}/packages/schemas/workers/voice_stt_audio_transcriptions.schema.json",
        "{workspaceRoot}/packages/schemas/tools/generate_pydantic.py",
        { "env": "SECRET_HUGGINGFACE_TOKEN" },
        { "env": "SECRET_BEAM_TOKEN" },
        { "env": "GENERATED_STT_AUDIO_TRANSCRIPTIONS_API_KEY" }
      ],
      "outputs": [],
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "PYTHONPATH": ".",
          "SECRET_HUGGINGFACE_TOKEN": "${SECRET_HUGGINGFACE_TOKEN}",
          "SECRET_STT_AUDIO_TRANSCRIPTIONS_API_KEY": "${GENERATED_STT_AUDIO_TRANSCRIPTIONS_API_KEY}",
          "BEAM_TOKEN": "${SECRET_BEAM_TOKEN}"
        },
        "command": "uv run --locked --project ../../../ beam deploy",
        "args": "worker_stt_audio_transcriptions_beam.py:generate"
      },
      "dependsOn": [
        "prebuild"
      ]
    },
    "deploy": {
      "executor": "nx:noop",
      "dependsOn": [
        "deploy-beam"
      ],
      "cache": false
    },
    "prebuild": {
      "executor": "nx:noop",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/packages/schemas/workers/voice_stt_audio_transcriptions.schema.json",
        "{workspaceRoot}/packages/schemas/tools/generate_pydantic.py",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock"
      ],
      "outputs": [
        "{projectRoot}/dist/contract_stt_audio_transcriptions.py"
      ],
      "dependsOn": [
        {
          "projects": [
            "schemas"
          ],
          "target": "build-pydantic",
          "options": "forward"
        }
      ],
      "options": {
        "source": "packages/schemas/workers/voice_stt_audio_transcriptions.schema.json",
        "out": "apps/workers/stt/dist/contract_stt_audio_transcriptions.py"
      }
    },
    "test-unit": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": [
        "prebuild"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "uv run --locked pytest",
        "args": "tests/unit/test_stt_audio_transcriptions_unit.py"
      }
    },
    "test-acceptance": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": [
        "deploy-beam"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "env": {
          "STT_AUDIO_TRANSCRIPTIONS_API_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts worker-stt)"
        },
        "command": "uv run --locked --project apps/workers/stt python",
        "args": "apps/workers/stt/tests/acceptance_stt_audio_transcriptions.py"
      }
    }
  }
}
