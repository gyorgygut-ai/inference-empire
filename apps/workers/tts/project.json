{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "worker-tts",
  "projectType": "application",
  "sourceRoot": "apps/workers/tts",
  "tags": ["type:app","scope:gpu-worker","model:tts"],
  "targets": {
    "stub-beam": {
      "executor": "dotenvx:run-commands",
      "continuous": true,
      "cache": false,
      "readyWhen": { "url": "http://127.0.0.1:18763/health" },
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "TTS_AUDIO_SPEECH_API_KEY": "${SECRET_TTS_AUDIO_SPEECH_API_KEY}"
        },
        "command": "uv run --locked --project ../../../ uvicorn",
        "args": "fakes.worker_tts_audio_speech_beam:app --host 127.0.0.1 --port 18763"
      }
    },
    "deploy-beam": {
      "executor": "dotenvx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/worker_tts_audio_speech_beam.py",
        "{projectRoot}/shared/**/*.py",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock",
        "{workspaceRoot}/packages/schemas/workers/voice_tts_audio_speech.schema.json",
        "{workspaceRoot}/packages/schemas/tools/generate_pydantic.py",
        { "env": "SECRET_HUGGINGFACE_TOKEN" },
        { "env": "SECRET_BEAM_TOKEN" },
        { "env": "SECRET_TTS_AUDIO_SPEECH_API_KEY" }
      ],
      "outputs": [],
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "PYTHONPATH": ".",
          "SECRET_HUGGINGFACE_TOKEN": "${SECRET_HUGGINGFACE_TOKEN}",
          "TTS_AUDIO_SPEECH_API_KEY": "${SECRET_TTS_AUDIO_SPEECH_API_KEY}",
          "BEAM_TOKEN": "${SECRET_BEAM_TOKEN}"
        },
        "command": "uv run --locked --project ../../../ beam deploy",
        "args": "worker_tts_audio_speech_beam.py:generate"
      },
      "dependsOn": ["prebuild"]
    },
    "deploy": {
      "executor": "nx:noop",
      "dependsOn": ["deploy-beam"],
      "cache": false
    },
    "prebuild": {
      "executor": "nx:noop",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/packages/schemas/workers/voice_tts_audio_speech.schema.json",
        "{workspaceRoot}/packages/schemas/tools/generate_pydantic.py",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock"
      ],
      "outputs": ["{projectRoot}/dist/contract_tts_audio_speech.py"],
      "dependsOn": [{"projects": ["schemas"], "target": "build-pydantic", "options": "forward"}],
      "options": {
        "source": "packages/schemas/workers/voice_tts_audio_speech.schema.json",
        "out": "apps/workers/tts/dist/contract_tts_audio_speech.py"
      }
    },
    "test-unit": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": ["prebuild"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "uv run --locked pytest",
        "args": "tests/unit/test_tts_audio_speech_unit.py"
      }
    },
    "test-acceptance": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": ["deploy-beam"],
      "options": {
        "cwd": "{workspaceRoot}",
        "env": {
          "TTS_AUDIO_SPEECH_API_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts worker-tts)",
          "TTS_AUDIO_SPEECH_API_KEY": "${SECRET_TTS_AUDIO_SPEECH_API_KEY}"
        },
        "command": "uv run --locked --project apps/workers/tts python",
        "args": "apps/workers/tts/tests/acceptance_tts_audio_speech.py"
      }
    }
  }
}
