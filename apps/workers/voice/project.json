{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "worker-voice",
  "projectType": "application",
  "sourceRoot": "apps/workers/voice",
  "tags": ["type:app","scope:gpu-worker","model:voice"],
  "targets": {
    "deploy-beam": {
      "executor": "dotenvx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/worker_voice_realtime_session_beam.py",
        "{projectRoot}/shared/**/*.py",
        "{projectRoot}/tools/seed_reference_voices.py",
        "{projectRoot}/references/**/*",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock",
        "{workspaceRoot}/packages/schemas/workers/voice.schema.json",
        "{workspaceRoot}/packages/schemas/tools/generate_pydantic.py",
        { "env": "SECRET_HUGGINGFACE_TOKEN" },
        { "env": "SECRET_BEAM_TOKEN" },
        { "env": "SECRET_VOICE_WORKER_AUTH_TOKEN" },
        { "env": "SECRET_STT_AUDIO_TRANSCRIPTIONS_API_KEY" },
        { "env": "SECRET_LLM_CHAT_COMPLETIONS_API_KEY" },
        { "env": "SECRET_TTS_AUDIO_SPEECH_API_KEY" }
      ],
      "outputs": [],
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "PYTHONPATH": ".",
          "SECRET_HUGGINGFACE_TOKEN": "${SECRET_HUGGINGFACE_TOKEN}",
          "SECRET_BEAM_TOKEN": "${SECRET_BEAM_TOKEN}",
          "VOICE_WORKER_AUTH_TOKEN": "${SECRET_VOICE_WORKER_AUTH_TOKEN}",
          "STT_AUDIO_TRANSCRIPTIONS_API_KEY": "${SECRET_STT_AUDIO_TRANSCRIPTIONS_API_KEY}",
          "STT_AUDIO_TRANSCRIPTIONS_API_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts worker-stt)",
          "LLM_CHAT_COMPLETIONS_API_KEY": "${SECRET_LLM_CHAT_COMPLETIONS_API_KEY}",
          "LLM_CHAT_COMPLETIONS_API_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts worker-llm)",
          "TTS_AUDIO_SPEECH_API_KEY": "${SECRET_TTS_AUDIO_SPEECH_API_KEY}",
          "TTS_AUDIO_SPEECH_API_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts worker-tts)"
        },
        "command": "uv run --locked --project ../../../ beam deploy",
        "args": "worker_voice_realtime_session_beam.py:generate"
      },
      "dependsOn": [
        "predeploy-beam",
        "prebuild",
        "worker-stt:deploy-beam",
        "worker-llm:deploy-beam",
        "worker-tts:deploy-beam"
      ]
    },
    "deploy": {
      "executor": "nx:noop",
      "dependsOn": ["deploy-beam"],
      "cache": false
    },
    "predeploy-beam": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "uv run --locked python",
        "args": "tools/seed_reference_voices.py"
      }
    },
    "test-unit": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": ["prebuild"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "uv run --locked pytest",
        "args": "tests/unit/test_realtime_session_unit.py"
      }
    },
    "test-integration": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": [
        "prebuild",
        { "projects": ["worker-stt"], "target": "stub-beam", "waitFor": "ready" },
        { "projects": ["worker-llm"], "target": "stub-beam", "waitFor": "ready" },
        { "projects": ["worker-tts"], "target": "stub-beam", "waitFor": "ready" }
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "env": {
          "REAL_STT_AUDIO_TRANSCRIPTIONS_API_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts worker-stt)",
          "REAL_STT_AUDIO_TRANSCRIPTIONS_API_KEY": "${SECRET_STT_AUDIO_TRANSCRIPTIONS_API_KEY}",
          "STUB_STT_AUDIO_TRANSCRIPTIONS_API_URL": "http://127.0.0.1:18761",
          "STUB_STT_AUDIO_TRANSCRIPTIONS_API_KEY": "${SECRET_STT_AUDIO_TRANSCRIPTIONS_API_KEY}",
          "REAL_LLM_CHAT_COMPLETIONS_API_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts worker-llm)",
          "REAL_LLM_CHAT_COMPLETIONS_API_KEY": "${SECRET_LLM_CHAT_COMPLETIONS_API_KEY}",
          "STUB_LLM_CHAT_COMPLETIONS_API_URL": "http://127.0.0.1:18762",
          "STUB_LLM_CHAT_COMPLETIONS_API_KEY": "${SECRET_LLM_CHAT_COMPLETIONS_API_KEY}",
          "REAL_TTS_AUDIO_SPEECH_API_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts worker-tts)",
          "REAL_TTS_AUDIO_SPEECH_API_KEY": "${SECRET_TTS_AUDIO_SPEECH_API_KEY}",
          "STUB_TTS_AUDIO_SPEECH_API_URL": "http://127.0.0.1:18763",
          "STUB_TTS_AUDIO_SPEECH_API_KEY": "${SECRET_TTS_AUDIO_SPEECH_API_KEY}"
        },
        "command": "uv run --locked --project apps/workers/voice pytest",
        "args": "apps/workers/voice/tests/integration/test_inference_backends.py"
      }
    },
    "dev-beam": {
      "executor": "dotenvx:run-commands",
      "continuous": true,
      "cache": false,
      "readyWhen": {
        "url": "http://127.0.0.1:{env.DEV_VOICE_WORKER_PORT}/health"
      },
      "dependsOn": [
        "worker-stt:deploy-beam",
        "worker-llm:deploy-beam",
        "worker-tts:deploy-beam"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "SECRET_HUGGINGFACE_TOKEN": "${SECRET_HUGGINGFACE_TOKEN}",
          "VOICE_WORKER_AUTH_TOKEN": "${SECRET_VOICE_WORKER_AUTH_TOKEN}",
          "STT_AUDIO_TRANSCRIPTIONS_API_KEY": "${SECRET_STT_AUDIO_TRANSCRIPTIONS_API_KEY}",
          "STT_AUDIO_TRANSCRIPTIONS_API_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts worker-stt)",
          "LLM_CHAT_COMPLETIONS_API_KEY": "${SECRET_LLM_CHAT_COMPLETIONS_API_KEY}",
          "LLM_CHAT_COMPLETIONS_API_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts worker-llm)",
          "TTS_AUDIO_SPEECH_API_KEY": "${SECRET_TTS_AUDIO_SPEECH_API_KEY}",
          "TTS_AUDIO_SPEECH_API_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts worker-tts)",
          "VOICE_REFERENCES_DIR": "tests/fixtures"
        },
        "command": "uv run --locked uvicorn",
        "args": "shared.worker_voice:build_app --factory --host 127.0.0.1 --port=\"$DEV_VOICE_WORKER_PORT\""
      }
    },
    "stub-beam": {
      "executor": "dotenvx:run-commands",
      "continuous": true,
      "cache": false,
      "readyWhen": {
        "url": "http://127.0.0.1:{env.DEV_VOICE_WORKER_PORT}/health"
      },
      "dependsOn": [
        { "projects": ["worker-stt"], "target": "stub-beam", "waitFor": "ready" },
        { "projects": ["worker-llm"], "target": "stub-beam", "waitFor": "ready" },
        { "projects": ["worker-tts"], "target": "stub-beam", "waitFor": "ready" }
      ],
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "SECRET_HUGGINGFACE_TOKEN": "${SECRET_HUGGINGFACE_TOKEN}",
          "VOICE_WORKER_AUTH_TOKEN": "${SECRET_VOICE_WORKER_AUTH_TOKEN}",
          "STT_AUDIO_TRANSCRIPTIONS_API_KEY": "${SECRET_STT_AUDIO_TRANSCRIPTIONS_API_KEY}",
          "STT_AUDIO_TRANSCRIPTIONS_API_URL": "http://127.0.0.1:18761",
          "LLM_CHAT_COMPLETIONS_API_KEY": "${SECRET_LLM_CHAT_COMPLETIONS_API_KEY}",
          "LLM_CHAT_COMPLETIONS_API_URL": "http://127.0.0.1:18762",
          "TTS_AUDIO_SPEECH_API_KEY": "${SECRET_TTS_AUDIO_SPEECH_API_KEY}",
          "TTS_AUDIO_SPEECH_API_URL": "http://127.0.0.1:18763",
          "VOICE_REFERENCES_DIR": "tests/fixtures"
        },
        "command": "uv run --locked uvicorn",
        "args": "shared.worker_voice:build_app --factory --host 127.0.0.1 --port=\"$DEV_VOICE_WORKER_PORT\""
      }
    },
    "e2e-dev": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": [
        "prebuild",
        { "target": "dev-beam", "waitFor": "ready" }
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "env": {
          "VOICE_REALTIME_SESSION_API_URL": "http://127.0.0.1:${DEV_VOICE_WORKER_PORT}",
          "VOICE_WORKER_AUTH_TOKEN": "${SECRET_VOICE_WORKER_AUTH_TOKEN}"
        },
        "command": "uv run --locked --project apps/workers/voice pytest",
        "args": "apps/workers/voice/tests/e2e/test_realtime_voice.py"
      }
    },
    "e2e-deploy": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": ["deploy-beam"],
      "options": {
        "cwd": "{workspaceRoot}",
        "env": {
          "VOICE_REALTIME_SESSION_API_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts worker-voice)",
          "VOICE_WORKER_AUTH_TOKEN": "${SECRET_VOICE_WORKER_AUTH_TOKEN}"
        },
        "command": "uv run --locked --project apps/workers/voice pytest",
        "args": "apps/workers/voice/tests/e2e/test_realtime_voice.py"
      }
    },
    "prebuild": {
      "executor": "nx:noop",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/packages/schemas/workers/voice.schema.json",
        "{workspaceRoot}/packages/schemas/tools/generate_pydantic.py",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock"
      ],
      "outputs": [
        "{projectRoot}/dist/contract_voice.py"
      ],
      "dependsOn": [
        {
          "projects": ["schemas"],
          "target": "build-pydantic",
          "options": "forward"
        }
      ],
      "options": {
        "source": "packages/schemas/workers/voice.schema.json",
        "out": "apps/workers/voice/dist/contract_voice.py"
      }
    }
  }
}
