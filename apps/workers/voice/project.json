{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "workers-voice",
  "projectType": "application",
  "sourceRoot": "apps/workers/voice",
  "tags": ["type:app", "scope:gpu-worker", "model:voice"],
  "targets": {
    "predeploy-beam": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "uv run --locked python tools/seed_reference_voices.py"
      }
    },
    "deploy-beam": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": ["predeploy-beam"],
      "options": {
        "cwd": "{projectRoot}",
        "env": {"PYTHONPATH": "."},
        "command": "uv run --locked --project ../../../ beam deploy",
        "args": "worker_voice_beam.py:generate"
      }
    },
    "serve-local": {
      "executor": "dotenvx:run-commands",
      "continuous": true,
      "cache": false,
      "readyWhen": {"url": "http://127.0.0.1:8765/health"},
      "options": {
        "cwd": "{projectRoot}",
        "command": "uv run --locked python -c pass && uv pip install --python .venv/bin/python --no-deps chatterbox-tts==0.1.7 && uv run --locked uvicorn",
        "args": "shared.worker_voice:build_app --factory --host 127.0.0.1 --port 8765"
      }
    },
    "test-e2e": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": [
        {"projects": ["workers-voice"], "target": "serve-local", "waitFor": "ready"}
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "uv run --locked python tests/probe_webrtc.py",
        "args": "--url http://127.0.0.1:8765 --output-dir .proof/local"
      }
    }
  }
}
