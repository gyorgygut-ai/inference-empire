{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "worker-voice",
  "projectType": "application",
  "sourceRoot": "apps/workers/voice",
  "tags": ["type:app","scope:gpu-worker","model:voice"],
  "targets": {
    "deploy-beam": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "PYTHONPATH": ".",
          "SECRET_HUGGINGFACE_TOKEN": "${SECRET_HUGGINGFACE_TOKEN}",
          "SECRET_BEAM_TOKEN": "${SECRET_BEAM_TOKEN}",
          "SECRET_VOICE_WORKER_AUTH_TOKEN": "${GENERATED_VOICE_WORKER_AUTH_TOKEN}",
          "SECRET_STT_AUDIO_TRANSCRIPTIONS_API_KEY": "${GENERATED_STT_AUDIO_TRANSCRIPTIONS_API_KEY}",
          "STT_AUDIO_TRANSCRIPTIONS_API_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts worker-stt)",
          "SECRET_LLM_CHAT_COMPLETIONS_API_KEY": "${GENERATED_LLM_CHAT_COMPLETIONS_API_KEY}",
          "LLM_CHAT_COMPLETIONS_API_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts worker-llm)",
          "SECRET_TTS_AUDIO_SPEECH_API_KEY": "${GENERATED_TTS_AUDIO_SPEECH_API_KEY}",
          "TTS_AUDIO_SPEECH_API_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts worker-tts)"
        },
        "command": "uv run --locked --project ../../../ beam deploy",
        "args": "worker_voice_realtime_session_beam.py:generate"
      },
      "dependsOn": [
        "prebuild",
        "worker-stt:deploy-beam",
        "worker-llm:deploy-beam",
        "worker-tts:deploy-beam"
      ]
    },
    "deploy": {
      "executor": "nx:noop",
      "dependsOn": ["deploy-beam"],
      "cache": false
    },
    "test-unit": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": ["prebuild"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "uv run --locked pytest",
        "args": "tests/unit/test_realtime_session_unit.py"
      }
    },
    "test-acceptance": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": ["deploy-beam"],
      "options": {
        "cwd": "{workspaceRoot}",
        "env": {
          "VOICE_REALTIME_SESSION_API_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts worker-voice)"
        },
        "command": "uv run --locked --project apps/workers/voice python",
        "args": "apps/workers/voice/tests/acceptance_realtime_session.py"
      }
    },
    "serve-local": {
      "executor": "dotenvx:run-commands",
      "continuous": true,
      "cache": false,
      "readyWhen": {
        "url": "http://127.0.0.1:8765/health"
      },
      "options": {
        "cwd": "{projectRoot}",
        "command": "uv run --locked python -c pass && uv pip install --python .venv/bin/python --no-deps chatterbox-tts==0.1.7 && uv run --locked uvicorn",
        "args": "shared.worker_voice:build_app --factory --host 127.0.0.1 --port 8765"
      }
    },
    "test-e2e": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": ["prebuild"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "uv run --locked pytest",
        "args": "tests/test_worker_voice_realtime_session_e2e.py"
      }
    },
    "prebuild": {
      "executor": "nx:noop",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/packages/schemas/workers/voice.schema.json",
        "{workspaceRoot}/packages/schemas/tools/generate_pydantic.py",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock"
      ],
      "outputs": [
        "{projectRoot}/dist/contract_voice.py"
      ],
      "dependsOn": [
        {
          "projects": ["schemas"],
          "target": "build-pydantic",
          "options": "forward"
        }
      ],
      "options": {
        "source": "packages/schemas/workers/voice.schema.json",
        "out": "apps/workers/voice/dist/contract_voice.py"
      }
    }
  }
}
