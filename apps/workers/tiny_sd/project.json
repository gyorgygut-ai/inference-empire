{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "workers-tiny_sd",
  "projectType": "application",
  "sourceRoot": "apps/workers/tiny_sd",
  "tags": [
    "type:app",
    "scope:gpu-worker",
    "model:tiny_sd"
  ],
  "targets": {
    "deploy-modal": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "HF_TOKEN": "${SECRET_HUGGINGFACE_TOKEN}",
          "R2_ACCESS_KEY": "${SECRET_R2_ACCESS_KEY}",
          "R2_SECRET_KEY": "${SECRET_R2_SECRET_KEY}",
          "R2_ENDPOINT": "${SECRET_R2_ENDPOINT}",
          "R2_BUCKET": "${R2_BUCKET}",
          "BEAM_TOKEN": "${SECRET_BEAM_TOKEN}",
          "MODAL_TOKEN_ID": "${SECRET_MODAL_TOKEN_ID}",
          "MODAL_TOKEN_SECRET": "${SECRET_MODAL_TOKEN_SECRET}"
        },
        "command": "uv run --locked --project ../../../ modal deploy",
        "args": "worker_tiny_sd_modal.py"
      },
      "dependsOn": [
        "predeploy"
      ]
    },
    "deploy-beam": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "PYTHONPATH": ".",
          "HF_TOKEN": "${SECRET_HUGGINGFACE_TOKEN}",
          "R2_ACCESS_KEY": "${SECRET_R2_ACCESS_KEY}",
          "R2_SECRET_KEY": "${SECRET_R2_SECRET_KEY}",
          "R2_ENDPOINT": "${SECRET_R2_ENDPOINT}",
          "R2_BUCKET": "${R2_BUCKET}",
          "BEAM_TOKEN": "${SECRET_BEAM_TOKEN}"
        },
        "command": "uv run --locked --project ../../../ beam deploy",
        "args": "worker_tiny_sd_beam.py:generate"
      },
      "dependsOn": [
        "predeploy"
      ]
    },
    "deploy": {
      "executor": "nx:noop",
      "dependsOn": [
        "deploy-modal",
        "deploy-beam"
      ],
      "cache": false
    },
    "generate-contract": {
      "executor": "nx:noop",
      "cache": true,
      "dependsOn": [
        {
          "projects": [
            "schemas"
          ],
          "target": "build-pydantic",
          "options": "forward"
        }
      ],
      "options": {
        "source": "packages/schemas/workers/tiny_sd.schema.json",
        "out": "apps/workers/tiny_sd/dist/contract_tiny_sd.py"
      }
    },
    "predeploy": {
      "executor": "nx:noop",
      "dependsOn": [
        "generate-contract"
      ],
      "cache": false
    }
  }
}
