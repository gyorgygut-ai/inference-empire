{
  "name": "router",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./src/router.ts",
  "scripts": {
    "schema": "npx tsx ../../packages/schemas/tools/generate-zod-from-json.ts ../../packages/schemas/${ROUTER_MODEL:-flux2}/schema.json src/schema.ts",
    "predev": "npm run schema",
    "dev": "tsx watch src/serve.ts",
    "build": "tsc -p tsconfig.build.${ROUTER_MODEL:-flux2}.json",
    "test": "vitest run"
  },
  "dependencies": {
    "itty-router": "^5.0.24",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@nx/vite": "^23.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
