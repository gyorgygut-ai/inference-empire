{
  "name": "router_legacy",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/router_legacy",
  "tags": [
    "type:app",
    "scope:router"
  ],
  "targets": {
    "generate-flux2-auth-token-dev": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": [
        "default"
      ],
      "outputs": [
        "{workspaceRoot}/dist/flux2/dev.env"
      ],
      "options": {
        "command": "npx tsx tools/generate-auth-token.ts",
        "cwd": "{workspaceRoot}",
        "envFile": "dist/flux2/dev.env",
        "envKey": "ROUTER_AUTH_TOKEN"
      }
    },
    "generate-flux2-auth-token-deploy": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": [
        "default"
      ],
      "outputs": [
        "{workspaceRoot}/dist/flux2/deploy.env"
      ],
      "options": {
        "command": "npx tsx tools/generate-auth-token.ts",
        "cwd": "{workspaceRoot}",
        "envFile": "dist/flux2/deploy.env",
        "envKey": "ROUTER_AUTH_TOKEN"
      }
    },
    "generate-krea2-auth-token-dev": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": [
        "default"
      ],
      "outputs": [
        "{workspaceRoot}/dist/krea2/dev.env"
      ],
      "options": {
        "command": "npx tsx tools/generate-auth-token.ts",
        "cwd": "{workspaceRoot}",
        "envFile": "dist/krea2/dev.env",
        "envKey": "ROUTER_AUTH_TOKEN"
      }
    },
    "generate-krea2-auth-token-deploy": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": [
        "default"
      ],
      "outputs": [
        "{workspaceRoot}/dist/krea2/deploy.env"
      ],
      "options": {
        "command": "npx tsx tools/generate-auth-token.ts",
        "cwd": "{workspaceRoot}",
        "envFile": "dist/krea2/deploy.env",
        "envKey": "ROUTER_AUTH_TOKEN"
      }
    },
    "dev-flux2-generate-router-url": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": [
        "default"
      ],
      "outputs": [
        "{workspaceRoot}/dist/flux2/dev.env"
      ],
      "options": {
        "command": "echo http://127.0.0.1:$(node -p \"new URL(process.env.FLUX2_ROUTER_URL).port\")",
        "envFile": "dist/flux2/dev.env",
        "envKey": "ROUTER_URL"
      }
    },
    "dev-krea2-generate-router-url": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": [
        "default"
      ],
      "outputs": [
        "{workspaceRoot}/dist/krea2/dev.env"
      ],
      "options": {
        "command": "echo http://127.0.0.1:$(node -p \"new URL(process.env.KREA2_ROUTER_URL).port\")",
        "envFile": "dist/krea2/dev.env",
        "envKey": "ROUTER_URL"
      }
    },
    "dev-flux2": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "dependsOn": [
        {
          "projects": [
            "worker-flux2"
          ],
          "target": "deploy-modal",
          "options": "forward"
        },
        {
          "projects": [
            "worker-flux2"
          ],
          "target": "deploy-beam",
          "options": "forward"
        },
        {
          "target": "generate-flux2-*",
          "options": "forward"
        },
        "dev-flux2-generate-router-url",
        "schemas:generate-flux2-*"
      ],
      "options": {
        "command": "PORT=$(node -p \"new URL(process.env.ROUTER_URL).port\") npm run dev",
        "cwd": "apps/router_legacy",
        "envFile": "dist/flux2/dev.env"
      }
    },
    "deploy-flux2": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "dependsOn": [
        {
          "projects": [
            "worker-flux2"
          ],
          "target": "deploy-modal",
          "options": "forward"
        },
        {
          "projects": [
            "worker-flux2"
          ],
          "target": "deploy-beam",
          "options": "forward"
        },
        {
          "target": "generate-flux2-*",
          "options": "forward"
        },
        "schemas:generate-flux2-*"
      ],
      "options": {
        "command": "tools/deploy-vercel.ts router from-root --token $FLUX2_ROUTER_VERCEL_TOKEN --org $FLUX2_ROUTER_VERCEL_ORG_ID --project-id $FLUX2_ROUTER_VERCEL_PROJECT_ID",
        "envKey": "ROUTER_URL",
        "envFile": "dist/flux2/deploy.env"
      }
    },
    "dev-krea2": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "continuous": true,
      "dependsOn": [
        {
          "projects": [
            "worker-krea2"
          ],
          "target": "deploy-modal",
          "options": "forward"
        },
        {
          "target": "generate-krea2-*",
          "options": "forward"
        },
        "dev-krea2-generate-router-url",
        "schemas:generate-krea2-*"
      ],
      "options": {
        "command": "PORT=$(node -p \"new URL(process.env.ROUTER_URL).port\") npm run dev",
        "cwd": "apps/router_legacy",
        "envFile": "dist/krea2/dev.env"
      }
    },
    "deploy-krea2": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "dependsOn": [
        {
          "projects": [
            "worker-krea2"
          ],
          "target": "deploy-modal",
          "options": "forward"
        },
        {
          "target": "generate-krea2-*",
          "options": "forward"
        },
        "schemas:generate-krea2-*"
      ],
      "options": {
        "command": "tools/deploy-vercel.ts krea2 from-root --token $KREA2_ROUTER_VERCEL_TOKEN --org $KREA2_ROUTER_VERCEL_ORG_ID --project-id $KREA2_ROUTER_VERCEL_PROJECT_ID",
        "envKey": "ROUTER_URL",
        "envFile": "dist/krea2/deploy.env"
      }
    }
  }
}
