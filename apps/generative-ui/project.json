{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "generative-ui",
  "projectType": "application",
  "sourceRoot": "apps/generative-ui",
  "tags": [
    "type:app",
    "scope:frontend"
  ],
  "targets": {
    "face-value": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "defaultConfiguration": "dev",
      "dependsOn": [
        {
          "projects": [
            "router"
          ],
          "target": "router-flux2",
          "params": "forward"
        },
        "face-value-generate-ts"
      ],
      "inputs": [
        "{workspaceRoot}/dist/router-flux2/dev.env",
        "{workspaceRoot}/dist/router-flux2/deploy.env"
      ],
      "configurations": {
        "dev": {
          "command": "npm run dev",
          "cwd": "apps/generative-ui",
          "envFile": "dist/router-flux2/dev.env"
        },
        "deploy": {
          "command": "tsx tools/deploy-vercel.ts generative-ui face-value generative-ui deploy APP_URL --env-file dist/router-flux2/deploy.env",
          "envFile": "dist/router-flux2/deploy.env"
        }
      }
    },
    "face-value-generate-ts": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        {
          "projects": [
            "router"
          ],
          "target": "router-flux2-generate-api"
        }
      ],
      "inputs": [
        "{workspaceRoot}/dist/router-flux2/api-dev.json"
      ],
      "outputs": [
        "{projectRoot}/generated/router_api.ts"
      ],
      "options": {
        "command": "tsx apps/router/scripts/generate-ts.ts dist/router-flux2/api-dev.json apps/generative-ui/generated/router_api.ts"
      }
    },
    "test-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["router"],
          "target": "router-flux2:dev"
        }
      ],
      "options": {
        "command": "npx vitest run --config apps/generative-ui/vitest.e2e.config.mts apps/generative-ui/tests/"
      }
    }
  }
}
