{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "generative-ui",
  "projectType": "application",
  "sourceRoot": "apps/generative-ui",
  "tags": ["type:app", "scope:ui"],
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "options": {
        "script": "build",
        "outputPath": "apps/generative-ui"
      },
      "dependsOn": [
        "enforce-env",
        "build-manifest"
      ],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/.next"],
      "cache": true
    },
    "build-manifest": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run build:manifest",
        "cwd": "apps/generative-ui"
      },
      "inputs": [
        "{projectRoot}/targets/face-value/vocabulary/en.ts",
        "{projectRoot}/scripts/generate-manifest.mjs"
      ],
      "outputs": [
        "{projectRoot}/public/site.webmanifest"
      ],
      "cache": true
    },
    "enforce-env": {
      "executor": "@inference/nx-enforce-env-variables:enforce",
      "options": {
        "schema": "{projectRoot}/env.schema.ts"
      },
      "cache": false
    },
    "gen-types-flux2": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx nx generate @inference/nx-codegen-json-schema-to-ts:json-to-ts --inference=packages/contracts/flux2/inference.json --api=packages/contracts/api-task-queue.json --output=apps/generative-ui/generated/face-value_contract.ts --no-interactive"
      },
      "inputs": ["{workspaceRoot}/packages/contracts/flux2/inference.json", "{workspaceRoot}/packages/contracts/api-task-queue.json"],
      "outputs": ["{projectRoot}/generated/face-value_contract.ts"],
      "cache": true
    },
    "dev": {
      "executor": "nx:run-script",
      "dependsOn": ["enforce-env", "face-value:dev"],
      "options": {
        "script": "dev"
      },
      "inputs": [
        { "env": "APP_URL" },
        { "env": "SECRET_AUTH_TOKEN" }
      ],
      "cache": false,
      "persistent": true
    },
    "start": {
      "executor": "nx:run-script",
      "options": { "script": "start" }
    },
    "lint": {
      "executor": "nx:run-script",
      "options": {
        "script": "lint"
      },
      "dependsOn": [
        "audit",
        "oxlint",
        "typecheck"
      ],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit -p tsconfig.json",
        "cwd": "apps/generative-ui"
      },
      "cache": true
    },
    "test-unit": {
      "executor": "nx:run-script",
      "options": {
        "script": "test:run"
      },
      "cache": true
    },
    "test": {
      "dependsOn": [
        "test-unit"
      ],
      "cache": false
    },
    "audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit --omit=dev && npm ci --dry-run",
        "cwd": "apps/generative-ui"
      },
      "cache": true
    },
    "verify": {
      "dependsOn": [
        "audit",
        "lint",
        "build",
        "test"
      ],
      "cache": false
    },
    "build-face-value": {
      "executor": "@nx-extend/vercel:build",
      "dependsOn": ["face-value:deploy"],
      "options": {
        "projectId": "prj_4cb8NT4UmsamehohRPUdomDHvPVV",
        "orgId": "team_J6vdHfx7Bjz7VVskbtdbL8kq",
        "framework": "nextjs",
        "nodeVersion": "22.x",
        "buildTarget": "generative-ui:build"
      },
      "inputs": [
        "production",
        "^production",
        { "env": "FACE_VALUE_UI_VERCEL_TOKEN" },
        { "env": "FACE_VALUE_UI_VERCEL_PROJECT_ID" },
        { "env": "FACE_VALUE_UI_VERCEL_ORG_ID" },
        { "env": "APP_URL" },
        { "env": "SECRET_AUTH_TOKEN" }
      ],
      "outputs": ["{projectRoot}/.vercel/output"],
      "cache": true
    },
    "deploy-face-value": {
      "executor": "@nx-extend/vercel:deploy",
      "options": {
        "deployment": "production"
      },
      "dependsOn": ["build-face-value", "router:router-flux2:deploy"],
      "inputs": [
        "production",
        "^production",
        { "env": "FACE_VALUE_UI_VERCEL_TOKEN" },
        { "env": "FACE_VALUE_UI_VERCEL_PROJECT_ID" },
        { "env": "FACE_VALUE_UI_VERCEL_ORG_ID" },
        { "env": "APP_URL" },
        { "env": "SECRET_AUTH_TOKEN" }
      ],
      "cache": false
    }
  }
}
