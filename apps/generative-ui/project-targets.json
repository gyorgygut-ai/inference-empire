{
  "$schema": "../../tools/nx-orchestrate-configurations/src/schema.json",
  "targets": [
    {
      "name": "face-value:dev",
      "base": "dev",
      "executor": "@inference/nx-distribute-env-variables:distribute",
      "dependsOn": ["router:router-flux2:dev", "generative-ui:gen-types-flux2"],
      "contract": "packages/contracts/flux2/inference.json",
      "env": ["APP_URL", "SECRET_AUTH_TOKEN"],
      "inputs": [
        "{projectRoot}/targets/face-value/**/*",
        "{workspaceRoot}/apps/router/dist/router-flux2/dev.env",
        "{workspaceRoot}/packages/contracts/api-task-queue.json"
      ],
      "outputs": ["{projectRoot}/.next"]
    },
    {
      "name": "face-value:deploy",
      "base": "build",
      "executor": "@inference/nx-distribute-env-variables:distribute",
      "dependsOn": ["router:router-flux2:deploy", "generative-ui:gen-types-flux2"],
      "contract": "packages/contracts/flux2/inference.json",
      "env": ["APP_URL", "SECRET_AUTH_TOKEN"],
      "inputs": [
        "{projectRoot}/targets/face-value/**/*",
        "{workspaceRoot}/apps/router/dist/router-flux2/deploy.env",
        "{workspaceRoot}/packages/contracts/api-task-queue.json"
      ],
      "outputs": ["{projectRoot}/.vercel/output"],
      "cache": false
    }
  ]
}
