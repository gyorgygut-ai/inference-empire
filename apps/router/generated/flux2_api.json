{
  "title": "ApiTaskQueue",
  "endpoints": {
    "submit": "POST /q",
    "poll": "GET /sup?id="
  },
  "schemas": {
    "InferRequest": {
      "title": "InferRequest",
      "type": "object",
      "required": [
        "input"
      ],
      "properties": {
        "input": {
          "title": "Flux2Klein9bInput",
          "required": [
            "prompt"
          ],
          "properties": {
            "prompt": {
              "type": "string"
            },
            "height": {
              "type": "integer",
              "default": 512
            },
            "width": {
              "type": "integer",
              "default": 512
            },
            "guidance_scale": {
              "type": "number",
              "default": 1
            },
            "num_inference_steps": {
              "type": "integer",
              "default": 4
            },
            "seed": {
              "type": [
                "integer",
                "null"
              ],
              "default": null
            },
            "input_image": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "reference_images": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          }
        }
      }
    },
    "InferResponse": {
      "title": "InferResponse",
      "type": "object",
      "required": [
        "task_id"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "description": "Opaque. base64(provider:originalTaskId)"
        }
      }
    },
    "InquireResponse": {
      "title": "InquireResponse",
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "PROCESSING",
            "COMPLETED",
            "FAILED",
            "CANCELLED"
          ]
        },
        "output": {
          "title": "Flux2Klein9bOutput",
          "required": [
            "artifact"
          ],
          "properties": {
            "artifact": {
              "type": "object",
              "required": [
                "presigned_url"
              ],
              "properties": {
                "presigned_url": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
