{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "router",
  "projectType": "application",
  "sourceRoot": "apps/router",
  "tags": [
    "type:app",
    "scope:router"
  ],
  "targets": {
    "router-flux2": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "defaultConfiguration": "dev",
      "inputs": [
        "{workspaceRoot}/dist/worker-flux2/deploy/MODAL_WORKER_URL",
        "{workspaceRoot}/dist/worker-flux2/deploy/BEAM_WORKER_URL"
      ],
      "dependsOn": [
        {
          "projects": [
            "worker-flux2"
          ],
          "target": "deploy-modal",
          "params": "forward"
        },
        {
          "projects": [
            "worker-flux2"
          ],
          "target": "deploy-beam",
          "params": "forward"
        },
        "router-flux2-generate-api",
        "router-flux2-generate-ts",
        "router-flux2-generate-auth-token",
        "router-flux2-upsert-url"
      ],
      "outputs": [
        "{workspaceRoot}/dist/router-flux2/dev/ROUTER_URL",
        "{workspaceRoot}/dist/router-flux2/deploy/ROUTER_URL"
      ],
      "configurations": {
        "dev": {
          "command": "MODAL_WORKER_URL=$(cat dist/worker-flux2/deploy/MODAL_WORKER_URL) BEAM_WORKER_URL=$(cat dist/worker-flux2/deploy/BEAM_WORKER_URL) SECRET_AUTH_TOKEN=$(cat dist/router-flux2/dev/ROUTER_SECRET_AUTH_TOKEN) PORT=4201 npx tsx watch apps/router/src/serve.ts"
        },
        "deploy": {
          "command": "MODAL_WORKER_URL=$(cat dist/worker-flux2/deploy/MODAL_WORKER_URL) SECRET_AUTH_TOKEN=$(cat dist/router-flux2/deploy/ROUTER_SECRET_AUTH_TOKEN) tsx tools/deploy-vercel.ts router router-flux2 router-flux2 deploy ROUTER_URL"
        }
      }
    },
    "router-flux2-upsert-url": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [
        "{workspaceRoot}/dist/router-flux2/dev/ROUTER_URL"
      ],
      "options": {
        "command": "tsx tools/orchestration/upsert-artifact.ts router-flux2 dev ROUTER_URL=http://127.0.0.1:4201"
      }
    },
    "router-flux2-generate-api": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/packages/contracts/flux2/inference.json",
        "{workspaceRoot}/packages/contracts/api-task-queue.json"
      ],
      "outputs": [
        "{workspaceRoot}/dist/router-flux2/dev/api.json",
        "{workspaceRoot}/dist/router-flux2/deploy/api.json"
      ],
      "options": {
        "command": "tsx apps/router/scripts/generate-api.ts packages/contracts/api-task-queue.json packages/contracts/flux2/inference.json dist/router-flux2/dev/api.json && tsx apps/router/scripts/generate-api.ts packages/contracts/api-task-queue.json packages/contracts/flux2/inference.json dist/router-flux2/deploy/api.json"
      }
    },
    "router-flux2-generate-ts": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        "router-flux2-generate-api"
      ],
      "defaultConfiguration": "dev",
      "inputs": [
        "{workspaceRoot}/dist/router-flux2/dev/api.json",
        "{workspaceRoot}/dist/router-flux2/deploy/api.json"
      ],
      "outputs": [
        "{projectRoot}/generated/api.ts"
      ],
      "configurations": {
        "dev": {
          "command": "tsx apps/router/scripts/generate-ts.ts dist/router-flux2/dev/api.json apps/router/generated/api.ts"
        },
        "deploy": {
          "command": "tsx apps/router/scripts/generate-ts.ts dist/router-flux2/deploy/api.json apps/router/generated/api.ts"
        }
      }
    },
    "router-flux2-generate-auth-token": {
      "executor": "nx:run-commands",
      "cache": false,
      "defaultConfiguration": "dev",
      "outputs": [
        "{workspaceRoot}/dist/router-flux2/dev/ROUTER_SECRET_AUTH_TOKEN",
        "{workspaceRoot}/dist/router-flux2/deploy/ROUTER_SECRET_AUTH_TOKEN"
      ],
      "configurations": {
        "dev": {
          "command": "TOKEN=$(tsx tools/orchestration/generate-auth-token.ts) && tsx tools/orchestration/upsert-artifact.ts router-flux2 dev ROUTER_SECRET_AUTH_TOKEN=$TOKEN"
        },
        "deploy": {
          "command": "TOKEN=$(tsx tools/orchestration/generate-auth-token.ts) && tsx tools/orchestration/upsert-artifact.ts router-flux2 deploy ROUTER_SECRET_AUTH_TOKEN=$TOKEN"
        }
      }
    },
    "router-krea2": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "defaultConfiguration": "dev",
      "dependsOn": [
        {
          "projects": [
            "worker-krea2"
          ],
          "target": "dev-modal",
          "params": "forward"
        },
        "router-krea2-generate-api",
        "router-krea2-generate-ts",
        "router-krea2-generate-auth-token",
        "router-krea2-upsert-url"
      ],
      "outputs": [
        "{workspaceRoot}/dist/router-krea2/dev/ROUTER_URL",
        "{workspaceRoot}/dist/router-krea2/deploy/ROUTER_URL"
      ],
      "configurations": {
        "dev": {
          "command": "MODAL_WORKER_URL=$(cat dist/worker-krea2/dev/MODAL_WORKER_URL) SECRET_AUTH_TOKEN=$(cat dist/router-krea2/dev/ROUTER_SECRET_AUTH_TOKEN) PORT=4202 npx tsx watch apps/router/src/serve.ts"
        },
        "deploy": {
          "command": "MODAL_WORKER_URL=$(cat dist/worker-krea2/deploy/MODAL_WORKER_URL) SECRET_AUTH_TOKEN=$(cat dist/router-krea2/deploy/ROUTER_SECRET_AUTH_TOKEN) tsx tools/deploy-vercel.ts router router-krea2 router-krea2 deploy ROUTER_URL"
        }
      }
    },
    "router-krea2-upsert-url": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [
        "{workspaceRoot}/dist/router-krea2/dev/ROUTER_URL"
      ],
      "options": {
        "command": "tsx tools/orchestration/upsert-artifact.ts router-krea2 dev ROUTER_URL=http://127.0.0.1:4202"
      }
    },
    "router-krea2-generate-api": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/packages/contracts/krea2/inference.json",
        "{workspaceRoot}/packages/contracts/api-task-queue.json"
      ],
      "outputs": [
        "{workspaceRoot}/dist/router-krea2/api-dev.json",
        "{workspaceRoot}/dist/router-krea2/api-deploy.json"
      ],
      "options": {
        "command": "tsx apps/router/scripts/generate-api.ts packages/contracts/api-task-queue.json packages/contracts/krea2/inference.json dist/router-krea2/api-dev.json && tsx apps/router/scripts/generate-api.ts packages/contracts/api-task-queue.json packages/contracts/krea2/inference.json dist/router-krea2/api-deploy.json"
      }
    },
    "router-krea2-generate-ts": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        "router-krea2-generate-api"
      ],
      "defaultConfiguration": "dev",
      "inputs": [
        "{workspaceRoot}/dist/router-krea2/api-dev.json",
        "{workspaceRoot}/dist/router-krea2/api-deploy.json"
      ],
      "outputs": [
        "{projectRoot}/generated/api.ts"
      ],
      "configurations": {
        "dev": {
          "command": "tsx apps/router/scripts/generate-ts.ts dist/router-krea2/api-dev.json apps/router/generated/api.ts"
        },
        "deploy": {
          "command": "tsx apps/router/scripts/generate-ts.ts dist/router-krea2/api-deploy.json apps/router/generated/api.ts"
        }
      }
    },
    "router-krea2-generate-auth-token": {
      "executor": "nx:run-commands",
      "cache": false,
      "defaultConfiguration": "dev",
      "outputs": [
        "{workspaceRoot}/dist/router-krea2/dev/ROUTER_SECRET_AUTH_TOKEN",
        "{workspaceRoot}/dist/router-krea2/deploy/ROUTER_SECRET_AUTH_TOKEN"
      ],
      "configurations": {
        "dev": {
          "command": "TOKEN=$(tsx tools/orchestration/generate-auth-token.ts) && tsx tools/orchestration/upsert-artifact.ts router-krea2 dev ROUTER_SECRET_AUTH_TOKEN=$TOKEN"
        },
        "deploy": {
          "command": "TOKEN=$(tsx tools/orchestration/generate-auth-token.ts) && tsx tools/orchestration/upsert-artifact.ts router-krea2 deploy ROUTER_SECRET_AUTH_TOKEN=$TOKEN"
        }
      }
    },
    "test-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "defaultConfiguration": "dev",
      "configurations": {
        "dev": {
          "command": "ACCEPTANCE_MODELS=${ACCEPTANCE_MODELS:-flux2} npx vitest run --config vitest.e2e.config.mts tests/acceptance-dev.e2e.spec.ts",
          "cwd": "apps/router"
        },
        "deploy": {
          "command": "ACCEPTANCE_MODELS=${ACCEPTANCE_MODELS:-flux2} npx vitest run --config vitest.e2e.config.mts tests/acceptance-deploy.e2e.spec.ts",
          "cwd": "apps/router"
        }
      }
    }
  }
}