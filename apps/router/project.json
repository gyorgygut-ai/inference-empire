{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "router",
  "projectType": "application",
  "sourceRoot": "apps/router",
  "tags": [
    "type:app",
    "scope:router"
  ],
  "targets": {
    "router-flux2": {
      "executor": "orchestrator:run-injected-command",
      "defaultBase": "main",
      "cache": false,
      "inputs": [
        "{projectRoot}/env.schema.ts",
        "{projectRoot}/env.schema.flux2.ts",
        "{workspaceRoot}/dist/worker-flux2/deploy/MODAL_WORKER_URL",
        "{workspaceRoot}/dist/worker-flux2/deploy/BEAM_WORKER_URL"
      ],
      "dependsOn": [
        {
          "projects": [
            "worker-flux2"
          ],
          "target": "deploy-modal",
          "params": "forward"
        },
        {
          "projects": [
            "worker-flux2"
          ],
          "target": "deploy-beam",
          "params": "forward"
        },
        "router-flux2-generate-api",
        "router-flux2-generate-ts"
      ],
      "outputs": [
        "{workspaceRoot}/dist/router-flux2/dev/PORT",
        "{workspaceRoot}/dist/router-flux2/deploy/ROUTER_URL"
      ],
      "options": {
        "command": "npx tsx watch src/serve.ts",
        "cwd": "apps/router",
        "inject": [
          {
            "env": "MODAL_WORKER_URL",
            "command": "../../tools/wait-for-artifact.ts",
            "args": [
              "input",
              "../../dist/worker-flux2/deploy/MODAL_WORKER_URL"
            ]
          },
          {
            "env": "BEAM_WORKER_URL",
            "command": "../../tools/wait-for-artifact.ts",
            "args": [
              "input",
              "../../dist/worker-flux2/deploy/BEAM_WORKER_URL"
            ]
          },
          {
            "env": "SECRET_AUTH_TOKEN",
            "command": "../../tools/generate-auth-token.ts",
            "artifact": "{workspaceRoot}/dist/router-flux2/dev/SECRET_AUTH_TOKEN"
          },
          {
            "env": "PORT",
            "command": "echo \"4201\"",
            "artifact": "{workspaceRoot}/dist/router-flux2/dev/PORT"
          }
        ]
      },
      "continuous": true
    },
    "router-flux2-generate-api": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/packages/contracts/flux2/inference.json",
        "{workspaceRoot}/packages/contracts/api-task-queue.json"
      ],
      "outputs": [
        "{workspaceRoot}/dist/router-flux2/dev/api.json",
        "{workspaceRoot}/dist/router-flux2/deploy/api.json"
      ],
      "options": {
        "command": "tsx apps/router/scripts/generate-api.ts packages/contracts/api-task-queue.json packages/contracts/flux2/inference.json dist/router-flux2/dev/api.json && tsx apps/router/scripts/generate-api.ts packages/contracts/api-task-queue.json packages/contracts/flux2/inference.json dist/router-flux2/deploy/api.json"
      }
    },
    "router-flux2-generate-ts": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        "router-flux2-generate-api"
      ],
      "defaultConfiguration": "dev",
      "inputs": [
        "{workspaceRoot}/dist/router-flux2/dev/api.json",
        "{workspaceRoot}/dist/router-flux2/deploy/api.json"
      ],
      "outputs": [
        "{projectRoot}/generated/api-flux2.ts"
      ],
      "configurations": {
        "dev": {
          "command": "tsx apps/router/scripts/generate-ts.ts dist/router-flux2/dev/api.json apps/router/generated/api-flux2.ts"
        },
        "deploy": {
          "command": "tsx apps/router/scripts/generate-ts.ts dist/router-flux2/deploy/api.json apps/router/generated/api-flux2.ts"
        }
      }
    },
    "router-flux2-generate-auth-token-deploy": {
      "executor": "orchestrator:run-command-with-artifact",
      "options": {
        "command": "tsx tools/generate-auth-token.ts",
        "artifact": "{workspaceRoot}/dist/router-flux2/deploy/SECRET_AUTH_TOKEN"
      }
    },
    "router-flux2-deploy": {
      "executor": "orchestrator:run-command-with-artifact",
      "cache": false,
      "dependsOn": [
        "router-flux2-generate-api",
        "router-flux2-generate-ts",
        "router-flux2-generate-auth-token-deploy"
      ],
      "inputs": [
        "{workspaceRoot}/dist/router-flux2/deploy/SECRET_AUTH_TOKEN"
      ],
      "options": {
        "command": "tsx tools/deploy-vercel.ts router router-flux2 router-flux2 deploy ROUTER_URL --token $ROUTER_VERCEL_TOKEN --org $ROUTER_VERCEL_ORG_ID --project-id $ROUTER_VERCEL_PROJECT_ID",
        "artifact": "{workspaceRoot}/dist/router-flux2/deploy/ROUTER_URL"
      }
    },
    "router-krea2": {
      "executor": "orchestrator:run-injected-command",
      "defaultBase": "main",
      "cache": false,
      "inputs": [
        "{projectRoot}/env.schema.ts",
        "{projectRoot}/env.schema.krea2.ts",
        "{workspaceRoot}/dist/worker-krea2/deploy/MODAL_WORKER_URL",
        "{workspaceRoot}/dist/router-krea2/dev/SECRET_AUTH_TOKEN"
      ],
      "dependsOn": [
        {
          "projects": [
            "worker-krea2"
          ],
          "target": "deploy-modal",
          "params": "forward"
        },
        "router-krea2-generate-api",
        "router-krea2-generate-ts"
      ],
      "outputs": [
        "{workspaceRoot}/dist/router-krea2/dev/PORT",
        "{workspaceRoot}/dist/router-krea2/deploy/ROUTER_URL"
      ],
      "options": {
        "command": "npx tsx watch src/serve.ts",
        "cwd": "apps/router",
        "inject": [
          {
            "env": "MODAL_WORKER_URL",
            "command": "../../tools/wait-for-artifact.ts",
            "args": [
              "input",
              "../../dist/worker-krea2/deploy/MODAL_WORKER_URL"
            ]
          },
          {
            "env": "SECRET_AUTH_TOKEN",
            "command": "../../tools/generate-auth-token.ts",
            "artifact": "{workspaceRoot}/dist/router-krea2/dev/SECRET_AUTH_TOKEN"
          },
          {
            "env": "PORT",
            "command": "echo \"4202\"",
            "artifact": "{workspaceRoot}/dist/router-krea2/dev/PORT"
          }
        ]
      },
      "continuous": true
    },
    "router-krea2-generate-api": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/packages/contracts/krea2/inference.json",
        "{workspaceRoot}/packages/contracts/api-task-queue.json"
      ],
      "outputs": [
        "{workspaceRoot}/dist/router-krea2/dev/api.json",
        "{workspaceRoot}/dist/router-krea2/deploy/api.json"
      ],
      "options": {
        "command": "tsx apps/router/scripts/generate-api.ts packages/contracts/api-task-queue.json packages/contracts/krea2/inference.json dist/router-krea2/dev/api.json && tsx apps/router/scripts/generate-api.ts packages/contracts/api-task-queue.json packages/contracts/krea2/inference.json dist/router-krea2/deploy/api.json"
      }
    },
    "router-krea2-generate-ts": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        "router-krea2-generate-api"
      ],
      "defaultConfiguration": "dev",
      "inputs": [
        "{workspaceRoot}/dist/router-krea2/dev/api.json",
        "{workspaceRoot}/dist/router-krea2/deploy/api.json"
      ],
      "outputs": [
        "{projectRoot}/generated/api-krea2.ts"
      ],
      "configurations": {
        "dev": {
          "command": "tsx apps/router/scripts/generate-ts.ts dist/router-krea2/dev/api.json apps/router/generated/api-krea2.ts"
        },
        "deploy": {
          "command": "tsx apps/router/scripts/generate-ts.ts dist/router-krea2/deploy/api.json apps/router/generated/api-krea2.ts"
        }
      }
    },
    "router-krea2-generate-auth-token-deploy": {
      "executor": "orchestrator:run-command-with-artifact",
      "options": {
        "command": "tsx tools/generate-auth-token.ts",
        "artifact": "{workspaceRoot}/dist/router-krea2/deploy/SECRET_AUTH_TOKEN"
      }
    },
    "router-krea2-deploy": {
      "executor": "orchestrator:run-command-with-artifact",
      "cache": false,
      "dependsOn": [
        "router-krea2-generate-api",
        "router-krea2-generate-ts",
        "router-krea2-generate-auth-token-deploy"
      ],
      "inputs": [
        "{workspaceRoot}/dist/router-krea2/deploy/SECRET_AUTH_TOKEN"
      ],
      "options": {
        "command": "tsx tools/deploy-vercel.ts router router-krea2 router-krea2 deploy ROUTER_URL --token $ROUTER_VERCEL_TOKEN --org $ROUTER_VERCEL_ORG_ID --project-id $ROUTER_VERCEL_PROJECT_ID",
        "artifact": "{workspaceRoot}/dist/router-krea2/deploy/ROUTER_URL"
      }
    }
  }
}
