{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "router",
  "projectType": "application",
  "sourceRoot": "apps/router",
  "tags": ["type:app", "scope:router"],
  "targets": {
    "generate-flux2-auth-token-dev": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/flux2/dev.env"],
      "options": {
        "command": "npx tsx tools/generate-auth-token.ts",
        "envFile": "dist/flux2/dev.env",
        "envKey": "ROUTER_AUTH_TOKEN"
      }
    },
    "generate-flux2-auth-token-deploy": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/flux2/deploy.env"],
      "options": {
        "command": "npx tsx tools/generate-auth-token.ts",
        "envFile": "dist/flux2/deploy.env",
        "envKey": "ROUTER_AUTH_TOKEN"
      }
    },
    "generate-krea2-auth-token-dev": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/krea2/dev.env"],
      "options": {
        "command": "npx tsx tools/generate-auth-token.ts",
        "envFile": "dist/krea2/dev.env",
        "envKey": "ROUTER_AUTH_TOKEN"
      }
    },
    "generate-krea2-auth-token-deploy": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/krea2/deploy.env"],
      "options": {
        "command": "npx tsx tools/generate-auth-token.ts",
        "envFile": "dist/krea2/deploy.env",
        "envKey": "ROUTER_AUTH_TOKEN"
      }
    },
    "dev-flux2-generate-router-url": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/flux2/dev.env"],
      "options": {
        "command": "echo http://127.0.0.1:5040",
        "envFile": "dist/flux2/dev.env",
        "envKey": "ROUTER_URL"
      }
    },
    "dev-krea2-generate-router-url": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/flux2/dev.env"],
      "options": {
        "command": "echo http://127.0.0.1:5042",
        "envFile": "dist/flux2/dev.env",
        "envKey": "ROUTER_URL"
      }
    },
    "dev-flux2": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "dependsOn": [
        { "target": "worker-flux2:deploy-modal", "options": "forward" },
        { "target": "generate-flux2-*", "options": "forward" },
        "dev-flux2-generate-router-url",
        "schemas:generate-flux2-*"
      ],
      "options": {
        "command": "PORT=5040 npm run dev",
        "cwd": "apps/router",
        "envFile": "dist/flux2/dev.env"
      }
    },
    "deploy-flux2": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "dependsOn": [
        { "target": "worker-flux2:deploy-modal", "options": "forward" },
        { "target": "generate-flux2-*", "options": "forward" },
        "schemas:generate-flux2-*"
      ],
      "options": {
        "command": "tools/deploy-vercel.ts --token $FLUX2_ROUTER_VERCEL_TOKEN --org $FLUX2_ROUTER_VERCEL_ORG_ID --project-id $FLUX2_ROUTER_VERCEL_PROJECT_ID",
        "envKey": "ROUTER_URL",
        "envFile": "dist/flux2/deploy.env"
      }
    },
    "dev-krea2": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "continuous": true,
      "dependsOn": [
        { "target": "worker-krea2:deploy-modal", "options": "forward" },
        { "target": "generate-krea2-*", "options": "forward" },
        "dev-krea2-generate-router-url",
        "schemas:generate-krea2-*"
      ],
      "options": {
        "command": "PORT=5042 npm run dev",
        "cwd": "apps/router",
        "envFile": "dist/krea2/dev.env"
      }
    },
    "deploy-krea2": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "dependsOn": [
        { "target": "worker-krea2:deploy-modal", "options": "forward" },
        { "target": "generate-krea2-*", "options": "forward" },
        "schemas:generate-krea2-*"
      ],
      "options": {
        "command": "tools/deploy-vercel.ts --token $KREA2_ROUTER_VERCEL_TOKEN --org $KREA2_ROUTER_VERCEL_ORG_ID --project-id $KREA2_ROUTER_VERCEL_PROJECT_ID",
        "envKey": "ROUTER_URL",
        "envFile": "dist/krea2/deploy.env"
      }
    }
  }
}
