{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "router",
  "projectType": "application",
  "sourceRoot": "apps/router",
  "tags": ["type:app", "scope:router"],
  "targets": {
    "generate-api-flux2": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/packages/contracts/api-task-queue.json",
        "{workspaceRoot}/packages/contracts/flux2/inference.json"
      ],
      "outputs": ["{workspaceRoot}/dist/router-flux2/api.json"],
      "options": {
        "command": "tsx apps/router/scripts/generate-api.ts packages/contracts/api-task-queue.json packages/contracts/flux2/inference.json dist/router-flux2/api.json"
      }
    },
    "generate-ts-flux2": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["generate-api-flux2"],
      "inputs": ["{workspaceRoot}/dist/router-flux2/api.json"],
      "outputs": ["{projectRoot}/generated/api-flux2.ts"],
      "options": {
        "command": "tsx apps/router/scripts/generate-ts.ts dist/router-flux2/api.json apps/router/generated/api-flux2.ts"
      }
    },
    "env-dev-flux2": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx tools/router-env.ts flux2 dev"
      }
    },
    "env-deploy-flux2": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx tools/router-env.ts flux2 deploy"
      }
    },
    "dev-flux2": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "dependsOn": [
        {
          "projects": ["worker-flux2"],
          "target": "deploy-modal",
          "params": "forward"
        },
        {
          "projects": ["worker-flux2"],
          "target": "deploy-beam",
          "params": "forward"
        },
        "env-dev-flux2",
        "generate-ts-flux2"
      ],
      "options": {
        "command": "ROUTER_MODEL=flux2 npx tsx tools/export-artifacts.ts dist/worker-flux2/deploy dist/router-flux2/dev -- npx tsx watch apps/router/src/serve.ts",
        "readyWhen": "listening on"
      }
    },
    "deploy-flux2": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["worker-flux2"],
          "target": "deploy-modal",
          "params": "forward"
        },
        {
          "projects": ["worker-flux2"],
          "target": "deploy-beam",
          "params": "forward"
        },
        "env-deploy-flux2",
        "generate-ts-flux2"
      ],
      "options": {
        "command": "ROUTER_MODEL=flux2 npx tsx tools/export-artifacts.ts dist/worker-flux2/deploy dist/router-flux2/deploy -- npx tsx tools/deploy-vercel.ts router --token $FLUX2_ROUTER_VERCEL_TOKEN --org $FLUX2_ROUTER_VERCEL_ORG_ID --project-id $FLUX2_ROUTER_VERCEL_PROJECT_ID > dist/router-flux2/deploy/ROUTER_URL"
      }
    },
    "generate-api-krea2": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/packages/contracts/api-task-queue.json",
        "{workspaceRoot}/packages/contracts/krea2/inference.json"
      ],
      "outputs": ["{workspaceRoot}/dist/router-krea2/api.json"],
      "options": {
        "command": "tsx apps/router/scripts/generate-api.ts packages/contracts/api-task-queue.json packages/contracts/krea2/inference.json dist/router-krea2/api.json"
      }
    },
    "generate-ts-krea2": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["generate-api-krea2"],
      "inputs": ["{workspaceRoot}/dist/router-krea2/api.json"],
      "outputs": ["{projectRoot}/generated/api-krea2.ts"],
      "options": {
        "command": "tsx apps/router/scripts/generate-ts.ts dist/router-krea2/api.json apps/router/generated/api-krea2.ts"
      }
    },
    "env-dev-krea2": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx tools/router-env.ts krea2 dev"
      }
    },
    "env-deploy-krea2": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx tools/router-env.ts krea2 deploy"
      }
    },
    "dev-krea2": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "dependsOn": [
        {
          "projects": ["worker-krea2"],
          "target": "deploy-modal",
          "params": "forward"
        },
        "env-dev-krea2",
        "generate-ts-krea2"
      ],
      "options": {
        "command": "ROUTER_MODEL=krea2 npx tsx tools/export-artifacts.ts dist/worker-krea2/deploy dist/router-krea2/dev -- npx tsx watch apps/router/src/serve.ts",
        "readyWhen": "listening on"
      }
    },
    "deploy-krea2": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["worker-krea2"],
          "target": "deploy-modal",
          "params": "forward"
        },
        {
          "projects": ["worker-krea2"],
          "target": "deploy-beam",
          "params": "forward"
        },
        "env-deploy-krea2",
        "generate-ts-krea2"
      ],
      "options": {
        "command": "ROUTER_MODEL=krea2 npx tsx tools/export-artifacts.ts dist/worker-krea2/deploy dist/router-krea2/deploy -- npx tsx tools/deploy-vercel.ts router --token $KREA2_ROUTER_VERCEL_TOKEN --org $KREA2_ROUTER_VERCEL_ORG_ID --project-id $KREA2_ROUTER_VERCEL_PROJECT_ID > dist/router-krea2/deploy/ROUTER_URL"
      }
    }
  }
}
