{
  "name": "router",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/router/src",
  "targets": {
    "predev": {
      "executor": "nx:noop",
      "dependsOn": [
        "prebuild"
      ]
    },
    "prebuild": {
      "executor": "nx:noop",
      "dependsOn": [
        "^prebuild",
        "prebuild-flux2",
        "prebuild-tiny-sd"
      ]
    },
    "prebuild-flux2": {
      "executor": "nx:noop",
      "dependsOn": [{ "projects": ["schemas"], "target": "build-ts", "options": "forward" }],
      "options": {
        "source": "packages/schemas/workers/flux2.schema.json",
        "out": "apps/router/dist/flux2.schema.ts"
      }
    },
    "prebuild-tiny-sd": {
      "executor": "nx:noop",
      "dependsOn": [{ "projects": ["schemas"], "target": "build-ts", "options": "forward" }],
      "options": {
        "source": "packages/schemas/workers/tiny_sd.schema.json",
        "out": "apps/router/dist/tiny_sd.schema.ts"
      }
    },
    "build": {
      "executor": "dotenvx:run-commands",
      "dependsOn": [
        "prebuild"
      ],
      "cache": true,
      "options": {
        "command": "echo 'no build step'"
      }
    },
    "dev-flux2": {
      "executor": "dotenvx:run-commands",
      "continuous": true,
      "cache": false,
      "readyWhen": {
        "url": "http://localhost:{env.DEV_ROUTER_FLUX2_PORT}"
      },
      "dependsOn": [
        "predev",
        "worker-flux2:deploy-beam"
      ],
      "options": {
        "cwd": "apps/router",
        "env": {
          "AUTH_TOKEN": "${GENERATED_ROUTER_FLUX2_AUTH_TOKEN}",
          "WORKER_BEAM_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts worker-flux2)",
          "CLOUDFLARE_INCLUDE_PROCESS_ENV": "true"
        },
        "command": "npx wrangler dev",
        "args": "-c wrangler.flux2.toml --port=\"$DEV_ROUTER_FLUX2_PORT\" --inspector-port 9229 --persist-to $NX_WORKSPACE_ROOT/tmp/wrangler/flux2"
      }
    },
    "dev-tinysd": {
      "executor": "dotenvx:run-commands",
      "continuous": true,
      "cache": false,
      "readyWhen": {
        "url": "http://localhost:{env.DEV_ROUTER_TINYSD_PORT}"
      },
      "dependsOn": [
        "predev",
        "worker-tiny_sd:deploy-beam"
      ],
      "options": {
        "cwd": "apps/router",
        "env": {
          "AUTH_TOKEN": "${GENERATED_ROUTER_TINYSD_AUTH_TOKEN}",
          "WORKER_BEAM_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts worker-tiny_sd)",
          "CLOUDFLARE_INCLUDE_PROCESS_ENV": "true"
        },
        "command": "npx wrangler dev",
        "args": "-c wrangler.tinysd.toml --port=\"$DEV_ROUTER_TINYSD_PORT\" --inspector-port 9230 --persist-to $NX_WORKSPACE_ROOT/tmp/wrangler/tinysd"
      }
    },
    "dev": {
      "executor": "nx:noop",
      "dependsOn": [
        "dev-flux2",
        "dev-tinysd"
      ]
    },
    "deploy-flux2": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": [
        "build",
        "worker-flux2:deploy-beam"
      ],
      "options": {
        "cwd": "apps/router",
        "env": {
          "AUTH_TOKEN": "${GENERATED_ROUTER_FLUX2_AUTH_TOKEN}",
          "WORKER_BEAM_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts worker-flux2)"
        },
        "commands": [
          "npx wrangler deploy {args}",
          "npx tsx $NX_WORKSPACE_ROOT/tools/worker-secrets.ts env.schema.deploy.ts | npx wrangler secret bulk {args}"
        ],
        "args": "-c wrangler.flux2.toml",
        "parallel": false
      }
    },
    "deploy-tinysd": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": [
        "build",
        "worker-tiny_sd:deploy-beam"
      ],
      "options": {
        "cwd": "apps/router",
        "env": {
          "AUTH_TOKEN": "${GENERATED_ROUTER_TINYSD_AUTH_TOKEN}",
          "WORKER_BEAM_URL": "$(npx tsx $NX_WORKSPACE_ROOT/tools/get-beam-url.ts worker-tiny_sd)"
        },
        "commands": [
          "npx wrangler deploy {args}",
          "npx tsx $NX_WORKSPACE_ROOT/tools/worker-secrets.ts env.schema.deploy.ts | npx wrangler secret bulk {args}"
        ],
        "args": "-c wrangler.tinysd.toml",
        "parallel": false
      }
    },
    "deploy": {
      "executor": "nx:noop",
      "dependsOn": [
        "deploy-flux2",
        "deploy-tinysd"
      ]
    }
  }
}
