{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "text",
  "projectType": "application",
  "sourceRoot": "apps/text",
  "tags": ["type:app", "scope:worker", "model:text"],
  "targets": {
    "test-unit": {
      "executor": "nx:run-commands",
      "options": { "command": "test -z \"$(find apps/text -name 'test_*.py' 2>/dev/null)\" && echo 'no tests (empty family)' || uv run --locked pytest apps/text -q", "cwd": "." },
      "inputs": ["default"],
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "uvx ruff check apps/text --line-length 100", "cwd": "." },
      "cache": true
    }
  }
}
