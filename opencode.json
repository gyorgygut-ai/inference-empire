{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "nx-mcp": {
        "type": "local",
        "command": [
          "npx",
          "nx",
          "mcp"
        ]
      },
      "maestro": {
        "type": "local",
        "command": [
          "maestro",
          "mcp",
          "--no-viewer",
          "--working-dir",
          "apps/face-value"
        ]
      }
    }
  }
}
