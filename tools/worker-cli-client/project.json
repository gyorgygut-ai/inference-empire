{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "worker-cli-client",
  "projectType": "application",
  "sourceRoot": "tools/worker-cli-client",
  "tags": ["type:tool", "scope:worker-cli-client"],
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked python tools/worker-cli-client/generate.py",
        "cwd": "."
      },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
        "options": { "command": "uvx ruff check tools/worker-cli-client/generate.py --line-length 100", "cwd": "." },
      "cache": true
    }
  }
}
