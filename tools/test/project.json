{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "test",
  "projectType": "library",
  "root": "tools/test",
  "tags": ["type:tool", "scope:test"],
  "implicitDependencies": ["*"],
  "targets": {
    "verify-tier-1-audit": {
      "executor": "nx:noop",
      "cache": false,
      "dependsOn": [
        "^lint",
        "^build",
        "^test-unit",
        "lint",
        "test-unit"
      ]
    },
    "test-unit": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "options": {
        "cwd": "tools/test",
        "command": "vitest run",
        "args": "--config vitest.config.mts --exclude 'acceptance.*.test.ts'"
      }
    },
    "preacceptance": {
      "executor": "nx:noop",
      "dependsOn": [
        { "projects": ["schemas"], "target": "build-ts", "options": "forward" }
      ],
      "options": {
        "source": "packages/schemas/env/config.schema.json",
        "out": "packages/schemas/env/config.schema.ts"
      }
    },
    "acceptance:dev": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": [
        "preacceptance",
        { "projects": ["face-value"], "target": "dev", "waitFor": "ready" }
      ],
      "options": {
        "cwd": "tools/test",
        "command": "vitest run",
        "args": "--config vitest.config.mts acceptance.dev.test.ts"
      }
    },
    "acceptance:dev-tinysd": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": [
        "preacceptance",
        { "projects": ["router"], "target": "dev-tinysd", "waitFor": "ready" }
      ],
      "options": {
        "cwd": "tools/test",
        "command": "vitest run",
        "args": "--config vitest.config.mts acceptance.dev-tinysd.test.ts"
      }
    },
    "acceptance:deploy": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "dependsOn": [
        "preacceptance",
        "face-value:deploy",
        "router:deploy",
        "worker-voice:deploy-beam",
        "worker-voice:test-acceptance"
      ],
      "options": {
        "cwd": "tools/test",
        "env": { "VERCEL_TOKEN": "${FACE_VALUE_VERCEL_TOKEN}" },
        "command": "vitest run",
        "args": "--config vitest.config.mts acceptance.deploy.test.ts"
      }
    },
    "e2e:dev": {
      "executor": "dotenvx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "npx nx run worker-voice:test-integration && npx nx run worker-voice:test-e2e"
      }
    },
    "e2e:deploy": {
      "executor": "nx:noop",
      "cache": false
    }
  }
}
