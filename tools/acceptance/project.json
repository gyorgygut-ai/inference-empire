{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "acceptance",
  "projectType": "library",
  "root": "tools/acceptance",
  "tags": ["type:tool", "scope:acceptance"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "orchestrator:clean",
        {
          "projects": ["face-value"],
          "target": "dev",
          "waitFor": "ready"
        }
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest run --config vitest.config.mts dev.test.ts"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["orchestrator:clean", "functions:deploy-flux2"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest run --config vitest.config.mts deploy.test.ts"
      }
    }
  }
}
