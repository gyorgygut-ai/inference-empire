#!/usr/bin/env python3
import shutil, tomllib, sys
from pathlib import Path

SKIP = {"__pycache__", "tests", "dist", "build", ".venv"}

def project_root(entry: Path) -> Path:
    for p in entry.parents:
        if (p / "pyproject.toml").exists():
            return p
    raise SystemExit("no pyproject.toml found")

def path_deps(root: Path):
    data = tomllib.loads((root / "pyproject.toml").read_text())
    src = data.get("tool", {}).get("uv", {}).get("sources", {})
    return [(root / v["path"]).resolve() for v in src.values() if "path" in v]

def copy_tree(src: Path, dst: Path):
    dst.parent.mkdir(parents=True, exist_ok=True)
    if src.is_dir():
        shutil.copytree(src, dst, dirs_exist_ok=True, ignore=shutil.ignore_patterns(*SKIP, "*.pyc"))
    else:
        shutil.copy2(src, dst)

def main():
    if len(sys.argv) != 3:
        sys.exit("usage: uv-build <entry> <out>")
    entry = Path(sys.argv[1]).resolve()
    out = Path(sys.argv[2]).resolve()
    root = project_root(entry)
    if out.exists():
        shutil.rmtree(out)
    copy_tree(entry, out / entry.name)
    for d in ["shared", "fakes"]:
        s = root / d
        if s.exists():
            copy_tree(s, out / d)
    ws = root.parents[2]
    for dep in path_deps(root):
        rel = dep.relative_to(ws)
        copy_tree(dep, out / rel)

if __name__ == "__main__":
    main()
