{
  "name": "nx-orchestrate-configurations",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/nx-orchestrate-configurations/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/tools/nx-orchestrate-configurations",
        "main": "tools/nx-orchestrate-configurations/src/index.ts",
        "tsConfig": "tools/nx-orchestrate-configurations/tsconfig.lib.json",
        "assets": [
          {
            "input": "./tools/nx-orchestrate-configurations/src",
            "glob": "**/!(*.ts)",
            "output": "./src"
          }
        ]
      }
    },
    "lint": { "executor": "@nx/eslint:lint" }
  }
}
