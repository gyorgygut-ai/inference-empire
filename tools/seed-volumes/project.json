{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "seed-volumes",
  "projectType": "application",
  "sourceRoot": "tools/seed-volumes",
  "tags": ["type:tool", "scope:seed-volumes"],
  "targets": {
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked python tools/seed-volumes/seed-volumes.py",
        "cwd": "."
      },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "uvx ruff check tools/seed-volumes/seed-volumes.py --line-length 100", "cwd": "." },
      "cache": true
    }
  }
}