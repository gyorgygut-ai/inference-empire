{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "seed-volumes",
  "projectType": "application",
  "sourceRoot": "tools/seed-volumes",
  "tags": ["type:tool", "scope:seed-volumes"],
  "targets": {
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked --with huggingface-hub==0.36.2 python tools/seed-volumes/seed-volumes.py",
        "cwd": "."
      },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked ruff check tools/seed-volumes --line-length 100",
        "cwd": "."
      },
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked pytest -q tools/seed-volumes/tests",
        "cwd": "."
      },
      "cache": false
    }
  }
}
