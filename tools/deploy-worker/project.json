{
  "name": "deploy-worker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/deploy-worker/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/tools/deploy-worker",
        "main": "tools/deploy-worker/src/index.ts",
        "tsConfig": "tools/deploy-worker/tsconfig.lib.json",
        "assets": [
          "tools/deploy-worker/*.md",
          {
            "input": "./tools/deploy-worker/src",
            "glob": "**/!(*.ts)",
            "output": "./src"
          },
          {
            "input": "./tools/deploy-worker/src",
            "glob": "**/*.d.ts",
            "output": "./src"
          },
          {
            "input": "./tools/deploy-worker",
            "glob": "executors.json",
            "output": "."
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test-unit": {
      "executor": "@nx/vitest:test",
      "options": {
        "config": "{projectRoot}/vitest.config.mts"
      },
      "inputs": ["default"],
      "cache": true
    }
  }
}
