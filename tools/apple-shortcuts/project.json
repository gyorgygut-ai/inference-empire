{
  "name": "apple-shortcuts",
  "projectType": "application",
  "sourceRoot": "tools/apple-shortcuts/src",
  "tags": ["type:tool", "scope:shortcuts"],
  "targets": {
    "lint": { "executor": "@nx/eslint:lint" },
    "test-unit": { "executor": "@nx/vitest:test" },
    "build": { "executor": "@nx/js:tsc" },
    "sign": {
      "executor": "nx:run-commands",
      "options": {
        "command": "shortcuts sign -i artifacts/test-time-notification_unsigned.shortcut -o artifacts/test-time-notification.shortcut",
        "cwd": "tools/apple-shortcuts"
      }
    },
    "sign:dirigera-list-devices": {
      "executor": "nx:run-commands",
      "options": {
        "command": "shortcuts sign -i artifacts/dirigera-list-devices_unsigned.shortcut -o artifacts/dirigera-list-devices.shortcut",
        "cwd": "tools/apple-shortcuts"
      }
    },
    "sign:dirigera-toggle-plug": {
      "executor": "nx:run-commands",
      "options": {
        "command": "shortcuts sign -i artifacts/dirigera-toggle-plug_unsigned.shortcut -o artifacts/dirigera-toggle-plug.shortcut",
        "cwd": "tools/apple-shortcuts"
      }
    }
  }
}