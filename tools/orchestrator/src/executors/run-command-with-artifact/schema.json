{
  "$schema": "https://json-schema.org/schema",
  "version": 2,
  "title": "RunCommandWithArtifact executor",
  "description": "Runs a shell command with arguments and writes stdout to an artifact file.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "description": "The shell command to execute"
    },
    "args": {
      "type": "array",
      "description": "Optional array of arguments passed to the command",
      "items": { "type": "string" }
    },
    "artifact": {
      "type": "string",
      "description": "Path to write command output as artifact (supports {workspaceRoot} token)"
    },
    "cwd": {
      "type": "string",
      "description": "Working directory (defaults to workspace root, `{workspaceRoot}`)",
      "default": "{workspaceRoot}"
    },
    "timeout": {
      "type": "number",
      "description": "Maximum execution time in milliseconds",
      "minimum": 1000,
      "maximum": 600000
    }
  },
  "required": ["command", "artifact"],
  "additionalProperties": false
}