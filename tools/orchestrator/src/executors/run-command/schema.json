{
  "$schema": "https://json-schema.org/schema",
  "version": 2,
  "title": "Orchestrator run-command executor",
  "description": "Runs a command with contract env injection resolved from declared contract inputs.",
  "type": "object",
  "properties": {
    "command": { "type": "string" },
    "args": { "type": "string" },
    "env": { "type": "object", "additionalProperties": { "type": "string" } },
    "cwd": { "type": "string" }
  },
  "required": ["command"]
}