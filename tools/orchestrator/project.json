{
  "name": "orchestrator",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/orchestrator/src",
  "projectType": "library",
  "tags": ["type:tool", "scope:orchestrator"],
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "rm -rf dist && find packages/schemas -mindepth 2 -name schema.ts -delete"
      }
    },
    "build": {
      "dependsOn": ["^build"]
    },
    "test-unit": {
      "executor": "@nx/vitest:test",
      "options": {
        "config": "{projectRoot}/vitest.config.mts"
      },
      "inputs": ["default"],
      "cache": true
    }
  }
}
