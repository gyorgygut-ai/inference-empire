{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "worker-<%= family %>",
  "projectType": "application",
  "sourceRoot": "apps/<%= family %>",
  "tags": ["type:app", "scope:gpu-worker", "model:<%= modelTag %>"],
  "targets": {
    "test-unit": {
      "executor": "@inference/workspace-plugin:pytest",
      "options": { "family": "<%= family %>", "mode": "unit" },
      "inputs": ["default"],
      "cache": true
    },
    "test": {},
    "test-e2e": {},
    "lint": {
      "executor": "@inference/workspace-plugin:ruff",
      "options": { "family": "<%= family %>" },
      "cache": true
    },
    "typecheck": {
      "executor": "@inference/workspace-plugin:ty",
      "options": { "family": "<%= family %>" },
      "cache": true
    },
    "validate-deps": {
      "executor": "@inference/workspace-plugin:validate-deps",
      "options": { "family": "<%= family %>", "python_version": "<%= pythonVersion %>" },
      "cache": true
    },
    "dev-modal": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "continuous": true,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/<%= family %>/dev.env"],
      "options": {
        "command": "uv",
        "args": ["run", "--locked", "python", "tools/serve-modal.py", "--worker=apps/<%= family %>/worker_modal_*.py"],
        "envFile": "dist/<%= family %>/dev.env",
        "envKey": "MODAL_WORKER_URL"
      }
    },
    "deploy-modal": {
      "executor": "orchestrator:run-command",
      "cache": false,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/<%= family %>/deploy.env"],
      "options": {
        "command": "tools/deploy-modal.ts",
        "args": ["--worker=apps/<%= family %>/worker_modal_*.py"],
        "envFile": "dist/<%= family %>/deploy.env",
        "envKey": "MODAL_WORKER_URL"
      }
    }
  }
}
