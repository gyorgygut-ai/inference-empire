{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "worker-<%= family %>",
  "projectType": "application",
  "sourceRoot": "apps/<%= family %>",
  "tags": ["type:app", "scope:gpu-worker", "model:<%= modelTag %>"],
  "targets": {
    "test-unit": {
      "executor": "@inference/workspace-plugin:pytest",
      "options": { "family": "<%= family %>", "mode": "unit" },
      "inputs": ["default"],
      "cache": true
    },
    "test": {},
    "test-e2e": {},
    "lint": {
      "executor": "@inference/workspace-plugin:ruff",
      "options": { "family": "<%= family %>" },
      "cache": true
    },
    "typecheck": {
      "executor": "@inference/workspace-plugin:ty",
      "options": { "family": "<%= family %>" },
      "cache": true
    },
    "validate-deps": {
      "executor": "@inference/workspace-plugin:validate-deps",
      "options": { "family": "<%= family %>", "python_version": "<%= pythonVersion %>" },
      "cache": true
    },
    "dev-modal": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "outputs": ["{workspaceRoot}/dist/worker-<%= family %>/dev/dev-modal.env"],
      "options": { "command": "tsx tools/deploy-modal.ts worker-<%= family %> dev dev-modal" }
    },
    "deploy-modal": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/dist/worker-<%= family %>/deploy/deploy-modal.env"],
      "options": { "command": "tsx tools/deploy-modal.ts worker-<%= family %> deploy deploy-modal" }
    }
  }
}
