{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "gpu-workers-<%= modelTag %>",
  "projectType": "application",
  "sourceRoot": "apps/gpu-workers/<%= family %>",
  "tags": ["type:app", "scope:gpu", "model:<%= modelTag %>"],
  "targets": {
    "test-unit": {
      "executor": "@inference/workspace-plugin:pytest",
      "options": { "family": "<%= family %>", "mode": "unit" },
      "inputs": ["default"],
      "cache": true
    },
    "test-e2e": {
      "executor": "@inference/workspace-plugin:pytest",
      "options": { "family": "<%= family %>", "mode": "e2e" },
      "cache": false
    },
    "lint": {
      "executor": "@inference/workspace-plugin:ruff",
      "options": { "family": "<%= family %>" },
      "cache": true
    },
    "typecheck": {
      "executor": "@inference/workspace-plugin:ty",
      "options": { "family": "<%= family %>" },
      "cache": true
    },
    "verify-deploy-gate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run python -c \"from apps.gpu_workers.<%= family %>._shared_<%= family %> import IMAGE_PIP_DEPS; print('\\n'.join(IMAGE_PIP_DEPS))\" | uv pip compile --python-version <%= pythonVersion %> -",
        "cwd": "."
      },
      "cache": true
    },
    "deploy-modal": {
      "executor": "nx:run-commands",
      "options": { "command": "uv run --locked modal deploy <%= family %>/worker_modal_cls_<%= family %>.py", "cwd": "." },
      "dependsOn": ["verify-deploy-gate"],
      "cache": false
    },
    "deploy-beam": {
      "executor": "nx:run-commands",
      "options": { "command": "echo 'Beam deploys on dispatch.put(); see AGENTS.md'", "cwd": "." },
      "dependsOn": ["verify-deploy-gate"],
      "cache": false
    },
    "deploy-flash": {
      "executor": "nx:run-commands",
      "options": { "command": "echo 'flash deploy --name <%= modelTag %>; see AGENTS.md'", "cwd": "." },
      "dependsOn": ["verify-deploy-gate"],
      "cache": false
    }
  }
}
