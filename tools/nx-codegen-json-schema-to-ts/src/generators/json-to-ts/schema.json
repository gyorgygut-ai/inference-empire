{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JsonToTs generator",
  "type": "object",
  "required": ["inference", "api", "output"],
  "additionalProperties": false,
  "properties": {
    "inference": {
      "type": "string",
      "description": "Workspace-relative inference JSON schema file path"
    },
    "api": {
      "type": "string",
      "description": "Workspace-relative API task queue JSON schema file path"
    },
    "output": {
      "type": "string",
      "description": "Workspace-relative output path, e.g. apps/router/generated/router-flux2_contract.ts"
    }
  }
}
