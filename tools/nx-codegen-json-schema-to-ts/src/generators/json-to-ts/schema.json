{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JsonToTs generator",
  "type": "object",
  "required": ["output"],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "type": "string",
      "description": "Legacy workspace-relative contract path, e.g. packages/contracts/flux2/inference.json"
    },
    "inference": {
      "type": "string",
      "description": "Workspace-relative inference path, e.g. packages/contracts/flux2/inference.json"
    },
    "api": {
      "type": "string",
      "description": "Workspace-relative api path, e.g. packages/contracts/api-task-queue.json"
    },
    "output": {
      "type": "string",
      "description": "Workspace-relative output path, e.g. apps/router/generated/router-flux2_contract.ts"
    }
  }
}
