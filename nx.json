{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json"
    ],
    "contracts": [
      "{workspaceRoot}/apps/*/shared/contract_*.json"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/tests/**",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json"
    ]
  },
  "targetDefaults": {
    "audit": {
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "cache": true
    },
    "test": {
      "cache": false
    },
    "verify": {
      "dependsOn": [
        "audit",
        "lint",
        "build",
        "test"
      ],
      "cache": false
    }
  },
  "plugins": [
    "@nx/next",
    "@nx/react",
    "@nx/node",
    "@nx/js",
    "@nx/eslint",
    {
      "plugin": "@nx/oxlint",
      "options": {
        "targetName": "oxlint"
      }
    },
    {
      "plugin": "./tools/workspace-plugin/src/inference/python.ts"
    }
  ],
  "nxCloudAccessToken": "",
  "useInferencePlugins": true,
  "analytics": true,
  "generators": {
    "@nx/next": {
      "application": {
        "style": "css",
        "linter": "eslint"
      }
    }
  }
}
