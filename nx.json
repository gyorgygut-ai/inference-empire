{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json"
    ],
    "schemas": [
      "{workspaceRoot}/packages/schemas/*/schema.json"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/tests/**",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json"
    ]
  },
  "targetDefaults": {
    "audit": {
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "cache": true
    },
    "test": {
      "cache": false
    },
    "verify": {
      "executor": "nx:noop",
      "dependsOn": [
        "audit",
        "lint",
        "build",
        "test"
      ],
      "cache": false
    },
    "verify-dev": {
      "executor": "nx:noop",
      "dependsOn": [
        "audit",
        "lint",
        "build",
        "test",
        "dev"
      ],
      "cache": false
    },
    "verify-deploy": {
      "executor": "nx:noop",
      "dependsOn": [
        "audit",
        "lint",
        "build",
        "test",
        "deploy"
      ],
      "cache": false
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ]
    },
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production",
        {
          "json": "{workspaceRoot}/tsconfig.json",
          "fields": [
            "extends",
            "files",
            "include"
          ]
        }
      ]
    }
  },
  "plugins": [
    "@nx/next",
    "@nx/react",
    "@nx/node",
    "@nx/js",
    "@nx/eslint",
    {
      "plugin": "@nx/oxlint",
      "options": {
        "targetName": "oxlint"
      }
    },
    {
      "plugin": "./tools/workspace-plugin/src/inference/python.ts"
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "eslint:lint"
      }
    }
  ],
  "nxCloudAccessToken": "",
  "useInferencePlugins": true,
  "analytics": true,
  "generators": {
    "@nx/next": {
      "application": {
        "style": "css",
        "linter": "eslint"
      }
    }
  },
  "affected": {
    "legacy": true
  }
}
