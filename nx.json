{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json"
    ],
    "contracts": [
      "{workspaceRoot}/packages/*/contract.json"
    ],
    "production": [
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/tests/**",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "cache": true
    },
    "build-manifest": {
      "inputs": [
        "contracts"
      ],
      "outputs": [
        "{projectRoot}/src/lib/manifest.json"
      ],
      "cache": true
    },
    "test-unit": {
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    },
    "e2e-sandbox-modal": {
      "inputs": [
        "default",
        "^production"
      ],
      "cache": false
    },
    "e2e-real": {
      "inputs": [
        "default",
        "^production"
      ],
      "cache": false
    },
    "lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/eslint.config.mjs"
      ],
      "cache": true
    },
    "typecheck": {
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    },
    "validate-deps": {
      "inputs": [
        "default"
      ],
      "cache": true
    },
    "deploy-modal": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/deploy/deploy-modal.mjs --router {projectName}",
        "cwd": "."
      },
      "dependsOn": [
        "validate-deps"
      ],
      "cache": false
    },
    "deploy-beam": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/deploy/deploy-beam.mjs --router {projectName}",
        "cwd": "."
      },
      "dependsOn": [
        "validate-deps"
      ],
      "cache": false
    },
    "deploy-flash": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/deploy/deploy-flash.mjs --router {projectName}",
        "cwd": "."
      },
      "dependsOn": [
        "validate-deps"
      ],
      "cache": false
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/worker-router/scripts/serve.mjs --router {projectName}",
        "cwd": "."
      },
      "continuous": true,
      "cache": false
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ]
    },
    "@nx/eslint:lint": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ]
    },
    "@nx/next:build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "default",
        "^production"
      ]
    },
    "preview": {
      "dependsOn": [
        "build"
      ]
    }
  },
  "plugins": [
    "@nx/next",
    "@nx/react",
    "@nx/node",
    "@nx/js",
    "@nx/eslint"
  ],
  "nxCloudAccessToken": "",
  "useInferencePlugins": false,
  "analytics": true,
  "generators": {
    "@nx/next": {
      "application": {
        "style": "css",
        "linter": "eslint"
      }
    }
  }
}
