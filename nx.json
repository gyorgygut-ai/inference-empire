{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json"
    ],
    "schemas": [
      "{workspaceRoot}/packages/schemas/*/schema.json"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/tests/**",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json"
    ]
  },
  "targetDefaults": {
    "audit": {
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "lint-fix": {
      "cache": false,
      "options": {
        "args": ["--fix"]
      }
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "cache": true
    },
    "test": {
      "cache": false
    },
    "verify": {
      "executor": "nx:noop",
      "dependsOn": [
        "verify-tier-1*",
        "verify-tier-2*",
        "verify-tier-3*"
      ],
      "cache": false
    },
    "verify-tier-1-audit": {
      "executor": "nx:noop",
      "dependsOn": [
        "lint",
        "build",
        "test-unit"
      ],
      "cache": false
    },
    "verify-tier-2-dev": {
      "executor": "nx:noop",
      "dependsOn": [
        "verify-tier-1*",
        "acceptance:dev*",
        "e2e:dev*"
      ],
      "cache": false
    },
    "verify-tier-3-deploy": {
      "executor": "nx:noop",
      "dependsOn": [
        "verify-tier-2*",
        "acceptance:deploy*",
        "e2e:deploy*"
      ],
      "cache": false
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ]
    },
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production",
        {
          "json": "{workspaceRoot}/tsconfig.json",
          "fields": [
            "extends",
            "files",
            "include"
          ]
        }
      ]
    }
  },
  "plugins": [
    "@nx/next",
    "@nx/react",
    "@nx/node",
    "@nx/js",
    {
      "plugin": "@nx/oxlint",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/oxlint",
      "options": {
        "targetName": "lint-fix"
      }
    },
    {
      "plugin": "./tools/workspace-plugin/src/inference/python.ts"
    },
    {
      "plugin": "./tools/workspace-plugin/src/inference/verification.ts"
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testMode": "watch",
        "testTargetName": "test-unit"
      },
      "include": [
        "tools/orchestrator/**/*",
        "tools/workspace-plugin/**/*"
      ]
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testMode": "run",
        "testTargetName": "vitest:test"
      },
      "include": [
        "packages/ui/**/*"
      ]
    }
  ],
  "nxCloudAccessToken": "",
  "useInferencePlugins": true,
  "analytics": true,
  "generators": {
    "@nx/next": {
      "application": {
        "style": "css",
        "linter": "none"
      }
    }
  },
  "affected": {
    "legacy": true
  }
}
