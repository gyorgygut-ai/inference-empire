{
  "input": {
    "title": "MiniMaxH3Ref2VAComfyInput",
    "required": ["prompt"],
    "properties": {
      "prompt": {
        "type": "string",
        "description": "Prompt describing the target shot; reference inputs by tag in connection order, e.g. <Picture 1>, <Video 1>, <Audio 1>."
      },
      "ref_images": {
        "type": "array",
        "items": { "type": "string" },
        "default": [],
        "maxItems": 9,
        "description": "Up to 9 reference images as base64 data URLs."
      },
      "ref_videos": {
        "type": "array",
        "items": { "type": "string" },
        "default": [],
        "maxItems": 3,
        "description": "Up to 3 reference video clips as base64 data URLs."
      },
      "ref_video_audios": {
        "type": "array",
        "items": { "type": "string" },
        "default": [],
        "maxItems": 3,
        "description": "Audio track paired with each reference video (index-aligned with ref_videos)."
      },
      "ref_audios": {
        "type": "array",
        "items": { "type": "string" },
        "default": [],
        "maxItems": 3,
        "description": "Up to 3 standalone reference audio clips."
      },
      "width": { "type": "integer", "default": 1344 },
      "height": { "type": "integer", "default": 768 },
      "length": { "type": "integer", "default": 124 },
      "steps": { "type": "integer", "default": 20 },
      "seed": { "type": ["integer", "null"], "default": null },
      "ref_image_size": {
        "type": "string",
        "enum": ["match", "max"],
        "default": "match"
      },
      "scheduler": {
        "type": "string",
        "enum": ["simple", "beta", "normal"],
        "default": "simple"
      }
    },
    "x-rules": {
      "ref_video_audios_index_aligned": "ref_video_audios is index-aligned with ref_videos and may not exceed it in length",
      "total_max_12": "sum(ref_images + ref_videos + ref_video_audios + ref_audios) <= 12",
      "audio_needs_visual": "reference audio requires at least one reference image or video"
    }
  },
  "output": {
    "title": "MiniMaxH3Ref2VAComfyOutput",
    "required": ["artifact", "video"],
    "properties": {
      "artifact": {
        "type": "object",
        "required": ["presigned_url"],
        "properties": {
          "presigned_url": { "type": "string" }
        }
      },
      "video": { "type": "string" }
    }
  }
}
