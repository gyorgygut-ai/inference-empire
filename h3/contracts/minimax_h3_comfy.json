{
  "input": {
    "title": "MiniMaxH3ComfyInput",
    "required": ["prompt"],
    "properties": {
      "prompt": { "type": "string" },
      "width": { "type": "integer", "default": 1344 },
      "height": { "type": "integer", "default": 768 },
      "length": { "type": "integer", "default": 124 },
      "steps": { "type": "integer", "default": 20 },
      "seed": { "type": ["integer", "null"], "default": null },
      "first_frame": { "type": ["string", "null"], "default": null },
      "last_frame": { "type": ["string", "null"], "default": null }
    }
  },
  "output": {
    "title": "MiniMaxH3ComfyOutput",
    "required": ["artifact", "video"],
    "properties": {
      "artifact": {
        "type": "object",
        "required": ["presigned_url"],
        "properties": {
          "presigned_url": { "type": "string" }
        }
      },
      "video": { "type": "string" }
    }
  }
}
