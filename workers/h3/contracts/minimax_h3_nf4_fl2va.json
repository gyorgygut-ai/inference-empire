  "properties": {
    "prompt": {
      "type": "string",
      "description": "Text prompt describing the target video."
    },
    "width": {
      "type": "integer",
      "default": 1344,
      "description": "Frame width in pixels (must be multiple of 16)."
    },
    "height": {
      "type": "integer",
      "default": 768,
      "description": "Frame height in pixels (must be multiple of 16)."
    },
    "length": {
      "type": "integer",
      "default": 124,
      "description": "Number of frames to generate."
    },
    "steps": {
      "type": "integer",
      "default": 50,
      "description": "Number of inference steps."
    },
    "seed": {
      "type": ["integer", "null"],
      "default": null,
      "description": "Random seed for reproducibility."
    },
    "first_frame": {
      "type": ["string", "null"],
      "default": null,
      "description": "Base64 data URL of the first frame image."
    },
    "last_frame": {
      "type": ["string", "null"],
      "default": null,
      "description": "Base64 data URL of the last frame image."
    }
  },
  "output": {
    "title": "MiniMaxH3Nf4Fl2vaOutput",
    "required": ["artifact"],
    "properties": {
      "artifact": {
        "type": "object",
        "required": ["presigned_url"],
        "properties": {
          "presigned_url": { "type": "string" }
        }
      }
    }
  }
}
