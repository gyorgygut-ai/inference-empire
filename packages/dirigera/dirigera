#!/usr/bin/env bash
# dirigera-api - authenticated Dirigera REST client
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
HUB="${DIRIGERA_HUB:-192.168.1.64}"
PORT=8443
TOKEN_FILE="${DIRIGERA_TOKEN_FILE:-$SCRIPT_DIR/.dirigera_token}"
BASE="https://${HUB}:${PORT}"

command -v jq >/dev/null || { echo "jq required (brew install jq)"; exit 1; }

# Try keychain first, fallback to file
get_token() {
  security find-generic-password -a "$USER" -s "dirigera" -w 2>/dev/null \
    || cat "$TOKEN_FILE" 2>/dev/null \
    || { echo "No token; run nx run dirigera:auth" >&2; exit 1; }
}

[ $# -ge 1 ] || { echo "Usage: dirigera <GET|PUT|POST|DELETE> <path> [json]"; echo "       dirigera token"; exit 1; }

if [ "${1:-}" = "token" ]; then
  get_token; exit 0
fi

[ $# -ge 2 ] || { echo "Usage: automation <METHOD> <path> [json]"; exit 1; }
method="$1"; path="$2"; body="${3:-}"
token=$(get_token)

args=(-k -s -m 10 -X "$method" "$BASE$path" -H "Authorization: Bearer $token" -H "Content-Type: application/json")
[ -n "$body" ] && args+=(-d "$body")
out=$(curl "${args[@]}")
printf '%s' "$out" | jq . 2>/dev/null || printf '%s\n' "$out"