{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "schemas",
  "projectType": "library",
  "sourceRoot": "packages/schemas",
  "tags": ["type:schemas"],
  "targets": {
    "build": {
      "executor": "dotenvx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/*/schema.json", "{workspaceRoot}/packages/generate-zod-from-json.ts"],
      "outputs": ["{projectRoot}/*/schema.ts"],
      "options": { "command": "tsx packages/generate-zod-from-json.ts", "args": "--all" },
      "configurations": {
        "flux2": { "args": "packages/schemas/flux2/schema.json packages/schemas/flux2/schema.ts" },
        "krea2": { "args": "packages/schemas/krea2/schema.json packages/schemas/krea2/schema.ts" },
        "tiny_sd": { "args": "packages/schemas/tiny_sd/schema.json packages/schemas/tiny_sd/schema.ts" },
        "vision": { "args": "packages/schemas/vision/schema.json packages/schemas/vision/schema.ts" }
      }
    }
  }
}