{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "schemas",
  "projectType": "library",
  "sourceRoot": "packages/schemas",
  "tags": ["type:schemas"],
  "targets": {
    "build-ts": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/{env,workers}/*.schema.json", "{projectRoot}/tools/generate-zod-from-json.ts"],
      "outputs": ["{options.out}"],
      "options": {
        "command": "npx tsx {projectRoot}/tools/generate-zod-from-json.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "build-pydantic": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/{env,workers}/*.schema.json",
        "{projectRoot}/tools/generate_pydantic.py",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock"
      ],
      "outputs": ["{options.out}"],
      "options": {
        "command": "uv run --locked --group dev python {projectRoot}/tools/generate_pydantic.py",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
