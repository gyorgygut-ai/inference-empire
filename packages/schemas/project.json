{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "schemas",
  "projectType": "library",
  "sourceRoot": "packages/schemas",
  "tags": ["type:schemas"],
  "targets": {
    "build-ts": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/{env,workers}/*.schema.json", "{projectRoot}/tools/generate-zod-from-json.ts"],
      "outputs": ["{options.out}"],
      "options": {
        "command": "npx tsx {projectRoot}/tools/generate-zod-from-json.ts --source={args.source} --out={args.out}",
        "cwd": "{workspaceRoot}"
      }
    },
    "build-ts-tiny-sd": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/{env,workers}/*.schema.json", "{projectRoot}/tools/generate-zod-from-json.ts"],
      "outputs": ["{options.out}"],
      "options": {
        "command": "npx tsx {projectRoot}/tools/generate-zod-from-json.ts --source={args.source} --out={args.out}",
        "cwd": "{workspaceRoot}"
      }
    },
    "build-env-ts": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/env/*.schema.json",
        "{projectRoot}/env/.env.schema.json",
        "{projectRoot}/tools/generate-zod-from-json.ts"
      ],
      "outputs": [
        "{workspaceRoot}/packages/schemas/env/.env.schema.ts"
      ],
      "options": {
        "command": "npx tsx packages/schemas/tools/generate-zod-from-json.ts --source packages/schemas/env/.env.schema.json --out packages/schemas/env/.env.schema.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "build-pydantic": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/{env,workers}/*.schema.json",
        "{projectRoot}/tools/generate_pydantic.py",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock"
      ],
      "outputs": ["{options.out}"],
      "options": {
        "command": "uv run --locked --group dev python {projectRoot}/tools/generate_pydantic.py",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
