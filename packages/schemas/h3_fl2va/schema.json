{
  "title": "Api",
  "type": "object",
  "required": [
    "input",
    "output"
  ],
  "properties": {
    "input": {
      "title": "MiniMaxH3TurboFl2vaInput",
      "type": "object",
      "required": [
        "prompt"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "description": "Prompt describing the target shot."
        },
        "first_frame": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Optional first keyframe as base64 data URL."
        },
        "last_frame": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Optional last keyframe as base64 data URL."
        },
        "width": {
          "type": "integer",
          "default": 1344,
          "description": "Frame width in pixels (must be multiple of 16). Turbo LoRA trained at 768p."
        },
        "height": {
          "type": "integer",
          "default": 768,
          "description": "Frame height in pixels (must be multiple of 16). Turbo LoRA trained at 768p."
        },
        "length": {
          "type": "integer",
          "default": 124,
          "description": "Number of frames to generate."
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "description": "Random seed for reproducibility."
        }
      }
    },
    "output": {
      "title": "MiniMaxH3TurboFl2vaOutput",
      "type": "object",
      "required": [
        "artifact"
      ],
      "properties": {
        "artifact": {
          "type": "object",
          "required": [
            "presigned_url"
          ],
          "properties": {
            "presigned_url": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
