{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "workers-core",
  "projectType": "library",
  "sourceRoot": "packages/workers-core",
  "tags": ["type:lib", "scope:python"],
  "targets": {
    "test-unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked pytest apps/gpu-workers/services -q",
        "cwd": "."
      },
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "uvx ruff check apps/gpu-workers/services --line-length 100", "cwd": "." },
      "cache": true
    }
  }
}
