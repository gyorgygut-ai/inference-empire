{
  "name": "apple-shortcuts",
  "projectType": "application",
  "sourceRoot": "packages/apple-shortcuts/src",
  "tags": [
    "type:tool",
    "scope:shortcuts"
  ],
  "targets": {
    "sign": {
      "executor": "dotenvx:run-commands",
      "options": {
        "command": "shortcuts sign",
        "args": "-i artifacts/test-time-notification_unsigned.shortcut -o artifacts/test-time-notification.shortcut",
        "cwd": "packages/apple-shortcuts"
      }
    },
    "sign:dirigera-list-devices": {
      "executor": "dotenvx:run-commands",
      "options": {
        "command": "shortcuts sign",
        "args": "-i artifacts/dirigera-list-devices_unsigned.shortcut -o artifacts/dirigera-list-devices.shortcut",
        "cwd": "packages/apple-shortcuts"
      }
    },
    "sign:dirigera-toggle-plug": {
      "executor": "dotenvx:run-commands",
      "options": {
        "command": "shortcuts sign",
        "args": "-i artifacts/dirigera-toggle-plug_unsigned.shortcut -o artifacts/dirigera-toggle-plug.shortcut",
        "cwd": "packages/apple-shortcuts"
      }
    }
  }
}
