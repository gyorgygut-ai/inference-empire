{
  "name": "ui",
  "root": "packages/ui",
  "sourceRoot": "packages/ui/src",
  "projectType": "library",
  "tags": ["type:ui"],
  "targets": {
    "test": {
      "executor": "nx:noop",
      "dependsOn": ["vitest:test"]
    },
    "test-unit": {
      "executor": "nx:noop",
      "dependsOn": ["vitest:test"]
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/ui",
        "main": "packages/ui/src/index.ts",
        "tsConfig": "packages/ui/tsconfig.lib.json"
      }
    }
  }
}
