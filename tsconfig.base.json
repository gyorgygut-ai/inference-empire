{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@inference/nx-generate-auth-token": [
        "./tools/nx-generate-auth-token/src/index.ts"
      ],
      "@inference/task-queue-client": [
        "./packages/task-queue-client/src/index.ts"
      ],
      "@inference/types": [
        "./packages/types/src/index.ts"
      ],
      "@inference/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@inference/workspace-plugin": [
        "./tools/workspace-plugin/src/index.ts"
      ],
      "@packages/schemas/*": [
        "./packages/schemas/*"
      ]
    }
  }
}
